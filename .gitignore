# --- OS and editors
.DS_Store
.idea/
.vscode/
*.swp

# --- Internal working documents (not published)
docs/
.initial-refs/

# --- Agent tooling: .agents/ and .claude/ are tracked (.claude/skills is a link to .agents/skills);
# per-user settings and local state are not
**/.claude/settings.json
**/.claude/settings.local.json
**/.claude/*.local.*
**/.claude/worktrees/

# --- Harness: only the scripts are tracked; working files, run state and archives are local
.pm/*
!.pm/bin/

# --- Evidence and test results: check records, logs, captures, Playwright output
output/
*.log
playwright-report/
blob-report/
test-results/
playwright/.cache/
coverage/

# --- Build output
target/
node_modules/
dist/
.vite/
*.tsbuildinfo
__pycache__/
*.pyc

# --- Environment files
.env
.env.*
!.env.example

# --- Keys and certificates (the emulator writes these; never commit them)
emulator_credentials
credentials
*.pem
*.p12
*.key
*.crt
*.jks

# --- Design critique: the engine binary is downloaded per machine; snapshots are evidence
.agents/skills/impeccable/scripts/bin/
.impeccable/
