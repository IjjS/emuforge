#!/usr/bin/env bash
# Entry point of the integration suite; pm-check runs it as the `integration` step.
#
# Builds the engine, Studio, the run's own emulator image (issue 68) and the product form's image (issue 34), starts
# the run's own aws-emulator (telemetry off) on a loopback port, runs the engine checks of tests/integration/engine one
# at a time, then the Studio flow checks of tests/integration/studio one at a time, stops everything it started and
# writes <checkout>/output/integration/report.json: emulator version and commit, the emulator image
# (emulator_image), the checkout's commit, the verdict of every manifest check (passed, failed, error, not-run)
# and the relay fidelity figure.
#
# Usage: run [--not-run <file>] [--on-request] [--full] [--services <file>], in any order. The --not-run file is a not-run list
# (.github/not-run.json, issue 53): its `checks` name manifest ids, each with a `reason`; its other keys are not read. A
# check is on request when its manifest row is labelled `on-request` (issue 315); without --on-request every such check
# is left out with the reason "on request: not part of a default run; run it with --on-request", and with it they run
# like every other check. A check that is listed and on request has the list's reason, with or without --on-request.
# A check is in the tier full when its row is labelled `full` (issue 482): without --full every such check is left
# out with the reason "full: runs only in the full run; run it with --full", and with it they run like every other
# check. Only .github/workflows/full.yml, which the owner starts, and a local run on the owner's word pass --full; no
# changed path calls a check of the tier. A row labelled both `full` and `on-request` makes every check `error`
# (exit 127) before anything is built or started, whatever the options. report.json says `full_tier`: {of, left_out},
# the number of the rows of the tier and of those left out (not-run), and the run prints it as
# `integration: full tier <left_out> of <of> left out` before its report line. A
# check left out is not executed: the engine checks get EMUFORGE_IT_NOT_RUN naming a file of the left-out ids, so
# support::check::check returns at once, and Playwright gets one --grep-invert pattern of the left-out Studio and
# product ids. Each is reported `not-run` with its reason and counts neither as passed nor as failed; everything else,
# the builds included, runs as when nothing is left out. A list that cannot be read, is not that shape or names an id
# twice or one the manifest does not hold makes every check `error` (exit 127) before anything is built or started.
#
# A check of a service is a manifest row whose `service` is a service name, the name of its folder under
# studio/src/providers/aws/area/services/ (issue 327); every other row is a check of no service and always runs.
# The --services file is JSON {"services": [<service name>, ...]} or {"services": null}; its other keys are not
# read. null is every service: nothing more is left out. With a list, every check of a service not in the list is
# left out as a listed check is, with the reason "service <s> not touched: its checks are not part of this run"; a
# name no row has selects nothing. When more than one reason applies, the list's comes first, then on request, then
# the tier, then the service. report.json says `services`: the file's list, sorted without repeats, or null when every service's
# checks were part of the run (without the option, with null, and in a report of a run that did not get to its
# checks). A services file that cannot be read, is not that shape or holds an entry that is not a service name makes
# every check `error` (exit 127) before anything is built or started. Any other argument, or any option twice, is
# refused with a usage line (exit 2). Only the list, the labels and the services file turn this on;
# EMUFORGE_IT_NOT_RUN from the caller is unset.
#
# The manifest (issue 402) is the main manifest's rows, tests/integration/manifest.jsonl in its order, then each
# service's rows, studio/services/<service>/manifest.jsonl, the services in name order; a folder under
# studio/services/ whose name is not a service name, or that holds no manifest.jsonl, adds no row. Before anything
# else the run writes it as <checkout>/output/integration/manifest.jsonl, which every later step reads; when a part
# cannot be read (a symbolic link at studio/services, at a service's folder or at its manifest included) no such
# file is written and the run meets it as it meets a main manifest that cannot be read. In a checkout that holds
# studio/services/, the run then refuses rows out of their place: a row of the main manifest with a `service`, a
# row of a service's manifest whose `service` is not that service, whose `module` is not studio or whose `path` is
# not a .spec.ts directly under studio/, and a check id held by two rows. It also refuses imports that reach a
# service's folder from outside: a .ts file under studio/ that imports a file under studio/services/<service>/
# and is neither in that folder nor one of its check files (a file every one of whose rows, at least one, is of
# that service), and any import of a .spec.ts file. An import is a relative specifier of `from '...'`,
# `import '...'`, `import('...')` or `require('...')`, read as text (a comment counts) and never run; symbolic
# links are not followed and node_modules is left out. Either refusal makes every check `error` (exit 127) with
# one reason naming the first finding and their number, before anything is built or started, whatever the options.
#
# Relay fidelity (engine/references/relay-fidelity.md): passed / total over the manifest rows labelled
# `transparency` whose verdict is passed or failed (`error` counts in neither). It is written into report.json as
# relay_fidelity {passed, total} and printed as the last line of the output:
#   relay fidelity <passed>/<total> emulator <version> commit <sha>
#
# Ports: EMULATOR_PORT, EMUFORGE_ENGINE_PORT and EMUFORGE_STUDIO_PORT when set (EMULATOR_PORT=9297, the owner's
# emulator, is refused), else a free loopback port each.
#
# The run's emulator image (issue 68): after the engine and Studio builds the run builds the checkout's
# infra/aws-emulator, uncommitted changes included, with Docker's build cache, as aws-emulator:it-<run id>, bounded at
# emulator_build_bound seconds (log output/logs/integration-emulator-build.log). A build that has not ended within the
# bound is the environment's: every check `error`. A build that exits with an error is the checkout's: no emulator
# starts and no check runs, every check not left out is `failed` with the reason. The report's version and commit are
# read from that image. The run then reads the machine's image aws-emulator once (its id and its label
# emuforge.source-tree, then its version by that id) and compares the two when the label is the tree id of
# infra/aws-emulator at HEAD and that folder has no uncommitted change: another version or commit makes every check
# `error`, naming .pm/bin/pm-emulator-image refresh. report.json's emulator_image is {id, machine, compared}, null when
# the run stopped before it read its image. After that read neither the run nor a check reads or writes the name
# aws-emulator: the run's emulator and every emulator a check starts run aws-emulator:it-<run id> (the tag comes from
# support/check.rs and studio/support/env.ts), every `docker run` of it with `--pull never`. The image is removed at
# the end with the two names of the product form.
#
# Product form (issue 34): the image of the root docker-compose.yml is built once per run under the run's own
# name (emuforge-it-product-<run id>), and the run's emulator image is tagged under the run's own name
# (emuforge-it-emulator-<run id>), so a check's `docker compose ... up --build` is a cache hit and never retags
# `emuforge` or `aws-emulator`. After a product build that passed, the emulator under that name is read: another
# version or commit than the run's image makes every check `error`. Both names are removed at the end, with the
# containers and networks of the forms the checks recorded and could not remove.
#
# Exit, over the checks that are not `not-run`: 0 when every one passed; 1 when any failed; 127 when there are only
# errors (the environment failed: Docker, cargo, bun, an emulator or product image build that has not ended within its
# bound, an emulator of another version than the run's image; pm-check records 127 as `error`) or every check is
# `not-run` (nothing was checked); 2 for a usage error. The engine and Studio are the subject, not the environment:
# when engine/ or studio/ does not exist or does not build, every check still runs and fails at its first engine or
# Studio step. An emulator image that does not build ends the run before any check, every check `failed` (exit 1).
set -euo pipefail

# Real AWS credentials, profiles and proxy settings never reach a check.
for name in $(compgen -e); do
  case "$name" in
    AWS_* | http_proxy | https_proxy | HTTP_PROXY | HTTPS_PROXY | all_proxy | ALL_PROXY | no_proxy | NO_PROXY)
      unset "$name" ;;
  esac
done
unset EMUFORGE_IT_ENGINE_BIN EMUFORGE_IT_ENGINE_BUILD EMUFORGE_IT_STUDIO_BUILD EMUFORGE_IT_VERDICTS EMUFORGE_IT_RUN_ID
unset EMUFORGE_IT_PRODUCT_IMAGE EMUFORGE_IT_EMULATOR_IMAGE EMUFORGE_IT_PRODUCT_BUILD EMUFORGE_IT_EMULATOR_VERSION
unset EMUFORGE_IT_EMULATOR_COMMIT EMUFORGE_IMAGE EMUFORGE_EMULATOR_IMAGE EMUFORGE_IT_NOT_RUN
unset NODE_OPTIONS NODE_PATH
export AWS_EC2_METADATA_DISABLED=true

usage() {
  echo "usage: tests/integration/run [--not-run <file>] [--on-request] [--full] [--services <file>]" >&2
  exit 2
}
not_run=no
not_run_file=
on_request=no
full=no
services=no
services_file=
while (($#)); do
  case "$1" in
    --not-run)
      [[ "$not_run" == no && $# -ge 2 ]] || usage
      not_run=yes; not_run_file="$2"; shift 2 ;;
    --on-request)
      [[ "$on_request" == no ]] || usage
      on_request=yes; shift ;;
    --full)
      [[ "$full" == no ]] || usage
      full=yes; shift ;;
    --services)
      [[ "$services" == no && $# -ge 2 ]] || usage
      services=yes; services_file="$2"; shift 2 ;;
    *) usage ;;
  esac
done

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$here"
checkout="$(cd ../.. && pwd)"
out="$checkout/output/integration"
logs="$checkout/output/logs"
rm -rf "$out/verdicts" "$out/logs" "$out/tmp" "$out/playwright" "$out/report.json" "$out/not-run.ids" \
  "$out/not-run.json" "$out/services.json" "$out/manifest.jsonl" "$out/emulator-image.json"
mkdir -p "$out/verdicts" "$logs"
manifest="$out/manifest.jsonl"
run_id="$(date +%s)-$$"
product_image="emuforge-it-product-$run_id"
emulator_image="emuforge-it-emulator-$run_id"
commit="$(git -C "$checkout" rev-parse HEAD 2>/dev/null || echo unknown)"
emulator_version=unknown
emulator_commit=unknown
# Seconds the product image build may take (issue 293). A cached build takes seconds and an uncached one on a runner
# a few minutes; one that waits for a registry that does not answer never ends by itself.
product_build_bound=600
# Seconds the run's own emulator image build may take (issue 68), as the product build.
emulator_build_bound=600
# The run's emulator image, built from the checkout: the one emulator image the run and its checks start.
pin="aws-emulator:it-$run_id"

# report <reason>: writes report.json from the manifest and the verdict files and prints the exit code. With a
# reason, the run did not get to its checks and every check is `error` with that reason.
report() {
  python3 -I - "$manifest" "$out/verdicts" "$out/report.json" "$emulator_version" "$emulator_commit" "$commit" \
    "$out/not-run.json" "$out/services.json" "$out/emulator-image.json" "${1:-}" <<'PY'
import json, pathlib, sys
manifest, verdicts, report, version, emulator_commit, commit, not_run, services, image, reason = sys.argv[1:]
# {id: reason} of the checks left out (the validated not-run list, the rows on request, the rows of the tier full,
# the checks of the services not touched); absent when none is.
listed = json.loads(pathlib.Path(not_run).read_text()) if pathlib.Path(not_run).exists() else {}
# The accepted services file's list, sorted without repeats, or null; absent without --services. A run that did not
# get to its checks left nothing out by service.
touched = json.loads(pathlib.Path(services).read_text()) if pathlib.Path(services).exists() and not reason else None
# The run's emulator image {id, machine, compared} once the run has read it; null before.
emulator_image = json.loads(pathlib.Path(image).read_text()) if pathlib.Path(image).exists() else None
checks = []
transparency = set()
tier = set()  # the ids of the rows labelled `full`
for line in pathlib.Path(manifest).read_text().splitlines():
    if not line.strip():
        continue
    row = json.loads(line)
    check_id = row["check_id"]
    if "transparency" in row.get("labels", []):
        transparency.add(check_id)
    if isinstance(row.get("labels"), list) and "full" in row["labels"]:
        tier.add(check_id)
    record = pathlib.Path(verdicts) / f"{check_id}.json"
    if reason:
        entry = dict(check_id=check_id, verdict="error", seconds=0, log=None, message=reason)
    elif check_id in listed:
        entry = dict(check_id=check_id, verdict="not-run", seconds=0, log=None, message=listed[check_id])
    elif record.exists():
        v = json.loads(record.read_text())
        entry = dict(check_id=check_id, verdict=v["verdict"], seconds=v["seconds"], log=v["log"], message=v.get("message", ""))
    else:
        entry = dict(check_id=check_id, verdict="error", seconds=0, log=None, message="the check wrote no verdict")
    checks.append(entry)
counted = [c for c in checks if c["check_id"] in transparency and c["verdict"] in ("passed", "failed")]
fidelity = dict(passed=sum(c["verdict"] == "passed" for c in counted), total=len(counted))
full_tier = dict(of=len(tier), left_out=sum(c["check_id"] in tier and c["verdict"] == "not-run" for c in checks))
pathlib.Path(report).write_text(json.dumps(dict(
    emulator_version=version, emulator_commit=emulator_commit, emulator_image=emulator_image, commit=commit,
    relay_fidelity=fidelity, services=touched, full_tier=full_tier, checks=checks), indent=1) + "\n")
for c in checks:
    print(f"  {c['verdict']:7} {c['check_id']}  {c['message'].splitlines()[0][:160] if c['message'] else ''}", file=sys.stderr)
print(f"integration: full tier {full_tier['left_out']} of {full_tier['of']} left out", file=sys.stderr)
verdicts = {c["verdict"] for c in checks if c["verdict"] != "not-run"}
print(0 if verdicts == {"passed"} else 1 if "failed" in verdicts else 127)
PY
}

# fidelity_line: the last line of every run, from report.json.
fidelity_line() {
  python3 -I - "$out/report.json" <<'PY' >&2
import json, sys
r = json.load(open(sys.argv[1]))
f = r["relay_fidelity"]
print(f"relay fidelity {f['passed']}/{f['total']} emulator {r['emulator_version']} commit {r['commit']}")
PY
}

preflight_error() {
  echo "integration: $1" >&2
  report "$1" >/dev/null
  echo "integration: report $out/report.json" >&2
  fidelity_line
  exit 127
}

# fail_all <reason>: the subject failed before any check could run (the emulator image did not build). Every manifest
# check gets a verdict `failed` with the reason, then report as at the end of a run: the checks the not-run list, the
# on-request and full labels or the services file left out stay `not-run`. Exits with report's code.
fail_all() {
  echo "integration: $1" >&2
  python3 -I - "$manifest" "$out/verdicts" "$1" <<'PY'
import json, pathlib, sys
manifest, verdicts, reason = sys.argv[1:]
for line in pathlib.Path(manifest).read_text().splitlines():
    if line.strip():
        check_id = json.loads(line)["check_id"]
        record = dict(check_id=check_id, verdict="failed", seconds=0, log=None, message=reason)
        (pathlib.Path(verdicts) / f"{check_id}.json").write_text(json.dumps(record))
PY
  local code
  code="$(report)"
  echo "integration: report $out/report.json, exit $code" >&2
  fidelity_line
  exit "$code"
}

# version_of <image>: the image's `aws-emulator --version`, one-shot without a network and without a pull, into
# read_version and read_commit; a value missing or out of the shape [0-9A-Za-z._+-]{1,64} is `unknown`, so no other
# text reaches a line or the report. Returns 1, both `unknown`, when the read fails.
version_of() {
  local text
  read_version=unknown
  read_commit=unknown
  text="$(docker run --rm --pull never --network none --entrypoint aws-emulator "$1" --version 2>&1)" || return 1
  read_version="$(sed -n 's/^Version: *//p' <<<"$text" | head -n 1)"
  read_commit="$(sed -n 's/^Commit: *//p' <<<"$text" | head -n 1)"
  [[ "$read_version" =~ ^[0-9A-Za-z._+-]{1,64}$ ]] || read_version=unknown
  [[ "$read_commit" =~ ^[0-9A-Za-z._+-]{1,64}$ ]] || read_commit=unknown
  return 0
}

# bounded <seconds> <command...>: runs the command in a session of its own (so its process group holds everything it
# starts), standard input from /dev/null, the rest inherited. Exits with the command's code (128 + n for signal n, 127
# when it cannot be started) after ending what is left of its group (SIGTERM, SIGKILL 3 s later). At the bound it ends
# the group (SIGTERM, SIGKILL 10 s later) and exits 124. On SIGTERM, SIGINT or SIGHUP to itself (pm-check ends the
# run's group) it ends the group by itself (SIGTERM, SIGKILL 3 s later) and exits 128 + n; a later signal does not
# restart that. A command that exits 124 by itself is taken for the bound: an `error`, never a wrong verdict
# (docker compose build has no such code of its own).
bounded() {
  python3 -I - "$@" <<'PY'
import os, signal, subprocess, sys, time
seconds, cmd = float(sys.argv[1]), sys.argv[2:]
proc = None
stopping = None
code = None


def reap():
    # The command's exit code once it has ended (and is reaped), else None.
    global code
    if code is None:
        try:
            pid, status = os.waitpid(proc.pid, os.WNOHANG)
        except ChildProcessError:  # not ours to wait for any more: nothing to report but that it ended
            code = 127
            return code
        if pid:
            code = 128 + os.WTERMSIG(status) if os.WIFSIGNALED(status) else os.WEXITSTATUS(status)
    return code


def end_group(grace):
    # SIGTERM to the command's group, SIGKILL to what is left of it after `grace` seconds.
    try:
        os.killpg(proc.pid, signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        return
    until = time.monotonic() + grace
    while time.monotonic() < until:
        reap()
        try:
            os.killpg(proc.pid, 0)
        except (ProcessLookupError, PermissionError):
            return
        time.sleep(0.05)
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    until = time.monotonic() + 5
    while reap() is None and time.monotonic() < until:
        time.sleep(0.05)


def on_signal(n, frame):
    global stopping
    if stopping is not None:
        return
    stopping = n
    if proc is not None:
        end_group(3)
        os._exit(128 + n)


for n in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(n, on_signal)
try:
    proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, start_new_session=True)
except OSError as e:
    print(f"bounded: cannot start {cmd[0]}: {e.strerror or e}", file=sys.stderr)
    sys.exit(128 + stopping if stopping is not None else 127)
if stopping is not None:  # a signal came while the command was being started
    end_group(3)
    os._exit(128 + stopping)
started = time.monotonic()
while reap() is None:
    if time.monotonic() - started >= seconds:
        end_group(10)
        os._exit(124)
    time.sleep(0.1)
end_group(3)
os._exit(code)
PY
}

free_port() {
  python3 -I -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'
}

# The manifest and its two guards (issue 402), first of all: it writes $manifest, the main manifest's bytes then
# each service's manifest's (studio/services/<s>/manifest.jsonl, the names held to the form and sorted), each part
# ended with a newline; when a part cannot be read (the main manifest, or a service's that is there and is not a
# regular file reached through real folders) it writes nothing and stops, and the readers below meet a manifest
# that cannot be read as they meet an unreadable main manifest. Without a folder studio/services it stops there.
# Else, when every part parses, it holds the rows to their place and then the imports to the service folders, and
# on a finding prints one reason and exits 1: the run then makes every check `error` with it. It reads only files
# under $here; a specifier is joined and normalized as text and only looked up among the walked files, so nothing it
# names is opened; it follows no symbolic link and starts no process. (Its output goes through a file, as below.)
if ! python3 -I - "$here" "$out" >"$out/service-files.out" <<'PY'
import json, os, posixpath, re, sys
here, out = sys.argv[1:]
checkout = os.path.dirname(os.path.dirname(here))
ID = re.compile(r"[a-z]+\.[a-z0-9-]+")
SERVICE = re.compile(r"[a-z][a-z0-9]*(-[a-z0-9]+)*")
MAIN = "tests/integration/manifest.jsonl"
STUDIO = "tests/integration/studio/"
SPECIFIERS = [re.compile(p) for p in (r"""\bfrom\s*['"](\.[^'"]*)['"]""", r"""\bimport\s*['"](\.[^'"]*)['"]""",
                                      r"""\bimport\s*\(\s*['"](\.[^'"]*)['"]""",
                                      r"""\brequire\s*\(\s*['"](\.[^'"]*)['"]""")]
CHECK_FILE = re.compile(re.escape(STUDIO) + r"[^/]+\.spec\.ts")


def unreadable():
    sys.exit(0)


def read(path):
    try:
        with open(path, "rb") as f:
            return f.read()
    except OSError:
        unreadable()


# 1 The manifest: [(its path relative to the checkout, service or None, bytes)].
parts = [(MAIN, None, read(os.path.join(here, "manifest.jsonl")))]
folder = os.path.join(here, "studio", "services")
if os.path.islink(folder):
    unreadable()
has_services = os.path.isdir(folder)
if has_services:
    try:
        names = sorted(n for n in os.listdir(folder) if SERVICE.fullmatch(n))
    except OSError:
        unreadable()
    for s in names:
        d = os.path.join(folder, s)
        m = os.path.join(d, "manifest.jsonl")
        if os.path.islink(d):
            unreadable()
        if not os.path.isdir(d) or not os.path.lexists(m):
            continue
        if os.path.islink(m) or not os.path.isfile(m):
            unreadable()
        parts.append((f"{STUDIO}services/{s}/manifest.jsonl", s, read(m)))
with open(os.path.join(out, "manifest.jsonl"), "wb") as f:
    f.write(b"".join(b if b.endswith(b"\n") or not b else b + b"\n" for _, _, b in parts))
# 2 A checkout without the folder is never refused.
if not has_services:
    sys.exit(0)
rows = []  # (part, its service, row)
try:
    for rel, s, data in parts:
        for line in data.decode("utf-8").splitlines():
            if line.strip():
                row = json.loads(line)
                if not isinstance(row, dict):
                    raise ValueError("a manifest line is not a JSON object")
                rows.append((rel, s, row))
except (ValueError, RecursionError):
    sys.exit(0)  # the run meets the manifest that does not parse as today


def named(cid):
    return cid if isinstance(cid, str) and ID.fullmatch(cid) else "a row"


def refuse(found, text, unit):
    print(f"service files: {text(found[0])} ({len(found)} {unit})")
    sys.exit(1)


def service_of(row):
    s = row.get("service")
    return s if isinstance(s, str) and SERVICE.fullmatch(s) else None


# 3 Rows: a service in the main manifest; a row of a service's manifest that is not a check of it in a check file;
# an id held by two rows.
found = [(rel, row) for rel, s, row in rows if s is None and service_of(row) is not None]
if found:
    refuse(found, lambda f: f"{named(f[1].get('check_id'))} in {f[0]} has the service {service_of(f[1])}; its row "
                            f"belongs in {STUDIO}services/{service_of(f[1])}/manifest.jsonl", "rows")
found = [(rel, s, row) for rel, s, row in rows if s is not None and (
    row.get("service") != s or row.get("module") != "studio"
    or not (isinstance(row.get("path"), str) and CHECK_FILE.fullmatch(row["path"])))]
if found:
    refuse(found, lambda f: f"{named(f[2].get('check_id'))} in {f[0]} is not a check of {f[1]} in a check file", "rows")
seen, twice = set(), []
for _, _, row in rows:
    cid = row.get("check_id")
    if isinstance(cid, str):
        if cid in seen and cid not in twice:
            twice.append(cid)
        seen.add(cid)
if twice:
    refuse(twice, lambda cid: f"{named(cid)} is held by two rows of the manifest", "ids")
# 4 Imports. The .ts files under studio/, no link followed, node_modules left out; paths relative to the checkout.
walked = set()
for top, dirs, files in os.walk(os.path.join(here, "studio"), followlinks=False):
    dirs[:] = sorted(d for d in dirs if d != "node_modules" and not os.path.islink(os.path.join(top, d)))
    for name in files:
        p = os.path.join(top, name)
        if name.endswith(".ts") and not os.path.islink(p) and os.path.isfile(p):
            walked.add(os.path.relpath(p, checkout).replace(os.sep, "/"))
of_path = {}
for _, _, row in rows:
    if isinstance(row.get("path"), str):
        of_path.setdefault(row["path"], set()).add(service_of(row))


def service_folder(path):
    """<s> when `path` is under studio/services/<s>/ with <s> of the form, else None."""
    rest = path[len(STUDIO + "services/"):] if path.startswith(STUDIO + "services/") else ""
    s = rest.split("/", 1)[0] if "/" in rest else ""
    return s if SERVICE.fullmatch(s) else None


foreign, specs = set(), set()
for importer in sorted(walked):
    try:
        with open(os.path.join(checkout, importer), encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        print(f"service files: {importer} cannot be read")
        sys.exit(1)
    for pattern in SPECIFIERS:
        for spec in pattern.findall(text):
            n = posixpath.normpath(posixpath.join(posixpath.dirname(importer), spec))
            imported = next((c for c in (n, n + ".ts", n + "/index.ts") if c in walked), None)
            if imported is None:
                continue
            s = service_folder(imported)
            if s is not None and service_folder(importer) != s and of_path.get(importer, set()) != {s}:
                foreign.add((importer, imported, s))
            if imported.endswith(".spec.ts"):
                specs.add((importer, imported))
if foreign:
    refuse(sorted(foreign), lambda f: f"{f[0]} imports {f[1]} of the service {f[2]}, and is not one of its check "
                                      f"files", "imports")
if specs:
    refuse(sorted(specs), lambda f: f"{f[0]} imports the check file {f[1]}", "imports")
PY
then
  reason="$(cat "$out/service-files.out")"
  rm -f "$out/service-files.out"
  preflight_error "${reason:-service files: cannot be checked}"
fi
rm -f "$out/service-files.out"

# What is left out, before anything is built or started: the not-run list given to --not-run, without
# --on-request every manifest row labelled `on-request` (each with the fixed reason ON_REQUEST below), without --full
# every row labelled `full` (FULL below) and, with a --services list, every check of a service not in it (each with
# the reason of service_reason below); an id left out for more than one reason has the list's, then on request's,
# then the tier's. A row labelled both `on-request` and `full` is refused. When anything is left out, or a list was given, it
# writes $out/not-run.json ({id: reason}) for report and $out/not-run.ids (one id per line) for the engine checks,
# and prints the Playwright pattern of the left-out .spec.ts ids (nothing when there is none); an accepted services
# file is written as $out/services.json (its list sorted without repeats, or null) for report. On a refusal of the
# list or of the services file it prints the reason. Only ids that have the form of a manifest id are used further,
# and a service name is only compared with manifest values. A manifest that cannot be read, when no list was given,
# leaves nothing out: the run ends at its report as it would without this block. (Its output goes through a file:
# bash 3.2 cannot parse a heredoc inside $(...).)
grep_invert=
if python3 -I - "$not_run" "$not_run_file" "$manifest" "$out" "$on_request" "$services" \
  "$services_file" "$full" >"$out/not-run.out" <<'PY'
import json, pathlib, re, sys
has_list, path, manifest, out, on_request, has_services, services_path, full = sys.argv[1:]
ON_REQUEST = "on request: not part of a default run; run it with --on-request"
FULL = "full: runs only in the full run; run it with --full"
ID = re.compile(r"[a-z]+\.[a-z0-9-]+")
SERVICE = re.compile(r"[a-z][a-z0-9]*(-[a-z0-9]+)*")


def service_reason(service):
    """The reason of a check of `service` when `service` is not in the services file's list."""
    return f"service {service} not touched: its checks are not part of this run"


def refuse(what):
    print(f"not-run list {path}: {what}")
    sys.exit(1)


def refuse_services(what):
    print(f"services file {services_path}: {what}")
    sys.exit(1)


def read_rows():
    return [json.loads(line) for line in pathlib.Path(manifest).read_text().splitlines() if line.strip()]


listed = {}
if has_list == "yes":
    try:
        data = json.loads(pathlib.Path(path).read_text())
    except OSError as e:
        refuse(f"cannot be read: {e.strerror or e}")
    except ValueError as e:
        refuse(f"is not JSON: {e}")
    if not isinstance(data, dict) or not isinstance(data.get("checks"), list):
        refuse('has no list "checks"')
    rows = read_rows()
    paths = {row["check_id"]: row["path"] for row in rows}
    for n, entry in enumerate(data["checks"]):
        if not isinstance(entry, dict) or not isinstance(entry.get("id"), str):
            refuse(f'checks[{n}] has no string "id"')
        check_id = entry["id"]
        if not isinstance(entry.get("reason"), str) or not entry["reason"].strip():
            refuse(f"checks[{n}] {check_id!r} has no reason")
        if not ID.fullmatch(check_id) or check_id not in paths:
            refuse(f"checks[{n}] {check_id!r} is not a check id of the manifest")
        if check_id in listed:
            refuse(f"checks[{n}] {check_id!r} is listed twice")
        listed[check_id] = entry["reason"]
else:
    try:
        rows = read_rows()
    except (OSError, ValueError):
        rows = []
    paths = {}
# The services file: {"services": null} or {"services": [<service name>, ...]}; its other keys are not read.
touched = None
if has_services == "yes":
    try:
        data = json.loads(pathlib.Path(services_path).read_text())
    except OSError as e:
        refuse_services(f"cannot be read: {e.strerror or e}")
    except ValueError as e:
        refuse_services(f"is not JSON: {e}")
    if not isinstance(data, dict) or "services" not in data:
        refuse_services('is not an object with the key "services"')
    names = data["services"]
    if names is not None:
        if not isinstance(names, list):
            refuse_services('"services" is neither null nor a list')
        for n, name in enumerate(names):
            if not isinstance(name, str) or not SERVICE.fullmatch(name):
                refuse_services(f"services[{n}] {name!r} is not a service name")
        touched = sorted(set(names))
    pathlib.Path(out, "services.json").write_text(json.dumps(touched) + "\n")


# Only a row whose `check_id` has the form of an id and whose `path` is a string can be left out by its label or its
# service; nothing of any other row reaches a command line.
def usable(row):
    return (isinstance(row, dict) and isinstance(row.get("check_id"), str) and ID.fullmatch(row["check_id"])
            and isinstance(row.get("path"), str))


def labelled(row, label):
    return isinstance(row, dict) and isinstance(row.get("labels"), list) and label in row["labels"]


# A row labelled both `on-request` and `full` is refused: the two tiers exclude each other.
both = [row for row in rows if labelled(row, "on-request") and labelled(row, "full")]
if both:
    cid = both[0].get("check_id")
    name = cid if isinstance(cid, str) and ID.fullmatch(cid) else "a row"
    print(f"manifest: {name} is labelled both on-request and full ({len(both)} such rows)")
    sys.exit(1)
# A row is on request when its `labels` is a list that holds `on-request`.
asked = {}
if on_request != "yes":
    for row in rows:
        if usable(row) and isinstance(row.get("labels"), list) and "on-request" in row["labels"]:
            asked[row["check_id"]] = ON_REQUEST
            paths.setdefault(row["check_id"], row["path"])
# A row is in the tier full when its `labels` is a list that holds `full`.
tier = {}
if full != "yes":
    for row in rows:
        if usable(row) and labelled(row, "full"):
            tier[row["check_id"]] = FULL
            paths.setdefault(row["check_id"], row["path"])
# A row is a check of a service when its `service` is a service name; any other row is a check of no service.
by_service = {}
if touched is not None:
    for row in rows:
        service = row.get("service") if isinstance(row, dict) else None
        if (usable(row) and isinstance(service, str) and SERVICE.fullmatch(service)
                and service not in touched):
            by_service[row["check_id"]] = service_reason(service)
            paths.setdefault(row["check_id"], row["path"])
left_out = {**by_service, **tier, **asked, **listed}
if not left_out and has_list != "yes":
    sys.exit(0)
pathlib.Path(out, "not-run.json").write_text(json.dumps(left_out, indent=1) + "\n")
pathlib.Path(out, "not-run.ids").write_text("".join(i + "\n" for i in left_out))
# A Playwright test's title is its check id; the pattern matches a title path that ends in one of them. An id is
# [a-z0-9-] around one `.`, so escaping the `.` is all a regular expression of Python or JavaScript needs.
specs = [i.replace(".", "\\.") for i in left_out if paths[i].endswith(".spec.ts")]
if specs:
    print("(^| )(" + "|".join(specs) + ")$")
PY
then
  grep_invert="$(cat "$out/not-run.out")"
  rm -f "$out/not-run.out"
else
  reason="$(cat "$out/not-run.out")"
  rm -f "$out/not-run.out"
  preflight_error "${reason:-not-run list $not_run_file: cannot be checked}"
fi
left_out=no
[[ -f "$out/not-run.ids" ]] && left_out=yes

# Ports.
if [[ "${EMULATOR_PORT:-}" == "9297" ]]; then
  echo "integration: EMULATOR_PORT=9297 is the owner's emulator; use another port or leave it unset" >&2
  exit 1
fi
EMULATOR_PORT="${EMULATOR_PORT:-$(free_port)}"
EMUFORGE_ENGINE_PORT="${EMUFORGE_ENGINE_PORT:-$(free_port)}"
EMUFORGE_STUDIO_PORT="${EMUFORGE_STUDIO_PORT:-$(free_port)}"
export EMULATOR_PORT EMUFORGE_ENGINE_PORT EMUFORGE_STUDIO_PORT
echo "integration: run $run_id, emulator port $EMULATOR_PORT, engine port $EMUFORGE_ENGINE_PORT," \
  "studio port $EMUFORGE_STUDIO_PORT" >&2

# Preflight: the environment, not the subject.
docker info >/dev/null 2>&1 || preflight_error "docker does not answer"
docker compose version >/dev/null 2>&1 || preflight_error "docker compose does not answer"
for tool in cargo curl shasum; do
  command -v "$tool" >/dev/null 2>&1 || preflight_error "$tool is not on PATH"
done
studio_manifest="$checkout/studio/package.json"
if [[ -f "$studio_manifest" ]]; then
  for tool in bun node; do
    command -v "$tool" >/dev/null 2>&1 || preflight_error "$tool is not on PATH"
  done
fi

# The engine under test.
engine_manifest="$checkout/engine/Cargo.toml"
target_dir="$checkout/engine/target"
if [[ -f "$engine_manifest" ]]; then
  if metadata="$(cargo metadata --manifest-path "$engine_manifest" --format-version 1 --no-deps 2>/dev/null)"; then
    target_dir="$(python3 -I -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])' <<<"$metadata")"
  fi
  if cargo build --manifest-path "$engine_manifest" --bin emuforge-server >"$logs/integration-engine-build.log" 2>&1; then
    engine_build=ok
  else
    engine_build=failed
    echo "integration: engine build failed, see $logs/integration-engine-build.log" >&2
  fi
else
  engine_build=absent
  echo "integration: $engine_manifest does not exist; every check will fail at its first engine step" >&2
fi
engine_bin="$target_dir/debug/emuforge-server"

# Studio under test: its locked dependencies and its production build, which the flow checks serve with
# `bun run serve`. Install and build write one log.
studio_log="$logs/integration-studio-build.log"
if [[ -f "$studio_manifest" ]]; then
  if (cd "$checkout/studio" && bun install --frozen-lockfile && bun run build) >"$studio_log" 2>&1; then
    studio_build=ok
  else
    studio_build=failed
    echo "integration: studio install or build failed, see $studio_log" >&2
  fi
else
  studio_build=absent
  echo "integration: $studio_manifest does not exist; every Studio check will fail at its first Studio step" >&2
fi

# The run's emulator.
emulator_dir="$HOME/.aws/emulator/$EMULATOR_PORT"
[[ -e "$emulator_dir" ]] \
  && preflight_error "$emulator_dir already exists; a leftover would be mistaken for this run's files"
container="emuforge-it-$EMULATOR_PORT-$run_id"
cleanup() {
  docker stop -t 10 "$container" >/dev/null 2>&1 || true
  docker rm -f "$container" >/dev/null 2>&1 || true
  # Containers a check started and could not remove (the test process was killed).
  local left
  left="$(docker ps -aq --filter "label=emuforge-it-run=$run_id" 2>/dev/null || true)"
  if [[ -n "$left" ]]; then
    # A killed container leaves its keys and ca.pem behind. Each one's directory did not exist when its check took
    # the port (the name is emuforge-it-<port>-<run id>), so it is removed with the container.
    local names name port
    names="$(docker inspect -f '{{.Name}}' $left 2>/dev/null || true)"
    docker rm -f $left >/dev/null 2>&1 || true
    for name in $names; do
      port="${name#/emuforge-it-}"
      port="${port%%-*}"
      if [[ "$port" =~ ^[0-9]+$ && -e "$HOME/.aws/emulator/$port" ]]; then
        rm -rf "$HOME/.aws/emulator/$port"
      fi
    done
  fi
  # The Docker volumes a check made and could not remove (support/volume.rs, issue 55). Each carries the run's
  # label; the containers that mounted them are gone by now, so Docker lets them go.
  local volumes
  volumes="$(docker volume ls -q --filter "label=emuforge-it-run=$run_id" 2>/dev/null || true)"
  if [[ -n "$volumes" ]]; then
    docker volume rm -f $volumes >/dev/null 2>&1 || true
  fi
  # A clean stop deletes the files; a kill would leave them. The directory did not exist before this run.
  if [[ -e "$emulator_dir" ]]; then
    rm -rf "$emulator_dir"
  fi
  # The product forms a check started and could not remove (the test process was killed). Each form records its
  # Compose project in $out/tmp/product-projects (support/product.ts); of those projects' containers, only the ones
  # created under one of the run's own image names are removed, so a project of the same name started elsewhere
  # (another worktree's form on a port this run let go) is left alone. Then the networks of those projects that no
  # container uses any more, and the volumes the removed containers mounted (issue 437): a form's volume holds the
  # files of its emulator, its keys among them after a kill. A volume of the same project name that none of this
  # run's containers mounted is another form's and is kept.
  local projects project id image cname rest mounted name
  if [[ -f "$out/tmp/product-projects" ]]; then
    projects="$(sort -u "$out/tmp/product-projects")"
    for project in $projects; do
      mounted=""
      while read -r id image cname rest; do
        [[ "$image" == "$product_image" || "$image" == "$emulator_image" ]] || continue
        mounted="$mounted $rest"
        docker rm -f "$id" >/dev/null 2>&1 && echo "integration: cleanup removed container ${cname#/}" >&2
      done < <(docker inspect -f '{{.Id}} {{.Config.Image}} {{.Name}}{{range .Mounts}}{{if eq .Type "volume"}} {{.Name}}{{end}}{{end}}' \
        $(docker ps -aq --filter "label=com.docker.compose.project=$project" 2>/dev/null) 2>/dev/null || true)
      for id in $(docker network ls -q --filter "label=com.docker.compose.project=$project" 2>/dev/null); do
        # A network still in use by a container is refused by Docker and kept.
        docker network rm "$id" >/dev/null 2>&1 && echo "integration: cleanup removed network $id of $project" >&2
      done
      for name in $(tr ' ' '\n' <<<"$mounted" | sort -u); do
        # A volume still used by another container, running or not, is refused by Docker and kept.
        docker volume rm "$name" >/dev/null 2>&1 && echo "integration: cleanup removed volume $name of $project" >&2
      done
    done
  fi
  docker image rm "$product_image" "$emulator_image" "$pin" >/dev/null 2>&1 || true
  rm -rf "$out/tmp"
}
trap cleanup EXIT

# The run's emulator image (issue 68): the checkout's infra/aws-emulator, built with Docker's cache and bounded as the
# product build. An error exit is the subject's (no emulator to run against, so no check runs); the bound is the
# environment's.
emulator_log="$logs/integration-emulator-build.log"
emulator_build_code=0
(cd "$checkout" && bounded "$emulator_build_bound" docker build --progress plain --tag "$pin" infra/aws-emulator) \
  >"$emulator_log" 2>&1 || emulator_build_code=$?
case "$emulator_build_code" in
  0) ;;
  124) preflight_error "the emulator image build did not end within $emulator_build_bound s, see $emulator_log" ;;
  *) fail_all "the emulator image did not build (exit $emulator_build_code), see $emulator_log" ;;
esac

# The emulator version, pinned for the run: the run's image's.
version_of "$pin" || preflight_error "aws-emulator --version failed"
emulator_version="$read_version"
emulator_commit="$read_commit"
pin_id="$(docker image inspect -f '{{.Id}}' "$pin" 2>/dev/null || true)"

# The machine's image, read once: its id and its label emuforge.source-tree from Docker's JSON array (an image without
# labels has no Labels key on the containerd store, which is an image without the label, not a failed read), then its
# version by that id, so a refresh that moves the name in between changes nothing. After this read the run never
# names the image aws-emulator again.
machine="$(docker image inspect aws-emulator 2>/dev/null | python3 -I -c '
import json, re, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
if not (isinstance(data, list) and len(data) == 1 and isinstance(data[0], dict)
        and isinstance(data[0].get("Id"), str) and re.fullmatch(r"[0-9A-Za-z:]{1,128}", data[0]["Id"])):
    sys.exit(0)
labels = (data[0].get("Config") or {}).get("Labels") or {}
label = labels.get("emuforge.source-tree") if isinstance(labels, dict) else None
print(data[0]["Id"], label if isinstance(label, str) and re.fullmatch(r"[0-9a-f]{1,64}", label) else "-")
' || true)"
machine_id="${machine%% *}"
machine_label="${machine#* }"
machine_version=
machine_commit=
if [[ -n "$machine" ]] && version_of "$machine_id" \
  && [[ "$read_version" != unknown && "$read_commit" != unknown ]]; then
  machine_version="$read_version"
  machine_commit="$read_commit"
fi
tree="$(git -C "$checkout" rev-parse HEAD:infra/aws-emulator 2>/dev/null || true)"
dirty="$(git -C "$checkout" status --porcelain -- infra/aws-emulator 2>/dev/null || echo unknown)"
compared=false
if [[ -n "$machine_version" && -n "$tree" && "$machine_label" == "$tree" && -z "$dirty" ]]; then
  compared=true
fi
python3 -I - "$out/emulator-image.json" "$pin_id" "$machine_version" "$machine_commit" "$compared" <<'PY'
import json, pathlib, sys
path, image_id, version, commit, compared = sys.argv[1:]
machine = dict(version=version, commit=commit) if version and commit else None
image = dict(id=image_id or None, machine=machine, compared=compared == "true")
pathlib.Path(path).write_text(json.dumps(image) + "\n")
PY
how="not compared"
[[ "$compared" == true ]] && how=compared
printf 'integration: emulator image %s %s (%s); machine image %s (%s)\n' "$pin" "$emulator_version" \
  "$emulator_commit" "${machine_version:-none}" "$how" >&2
if [[ "$compared" == true && ( "$machine_version" != "$emulator_version" || "$machine_commit" != "$emulator_commit" ) ]]
then
  preflight_error "the emulator built for this run is $emulator_version ($emulator_commit), the machine's image aws-emulator is $machine_version ($machine_commit); run .pm/bin/pm-emulator-image refresh"
fi

# The product form's images: the run's tag of its emulator image, then the product image, built once with the root
# docker-compose.yml under the run's name. A missing file or a failed build is the subject's, not the environment's:
# every product check still runs and fails at its start command, as the engine checks do without an engine. A build
# that passed wrote the emulator under the run's name again (a cache hit of the build above); it is held to the run's
# version before the run's emulator starts.
docker tag "$pin" "$emulator_image" || preflight_error "cannot tag $pin as $emulator_image"
product_log="$logs/integration-product-build.log"
if [[ -f "$checkout/docker-compose.yml" ]]; then
  # Bounded (issue 293): a build that has not ended within product_build_bound seconds is the environment's failure.
  build_code=0
  (cd "$checkout" && EMUFORGE_IMAGE="$product_image" EMUFORGE_EMULATOR_IMAGE="$emulator_image" \
    bounded "$product_build_bound" docker compose --progress plain build) >"$product_log" 2>&1 || build_code=$?
  case "$build_code" in
    0) product_build=ok ;;
    124) preflight_error "the product image build did not end within $product_build_bound s, see $product_log" ;;
    *)
      product_build=failed
      echo "integration: product image build failed, see $product_log" >&2
      ;;
  esac
else
  product_build=absent
  echo "integration: $checkout/docker-compose.yml does not exist; every product check will fail at its start" >&2
  echo "$checkout/docker-compose.yml does not exist" >"$product_log"
fi
if [[ "$product_build" == ok ]]; then
  product_read=ok
  version_of "$emulator_image" || product_read=failed
  if [[ "$product_read" == failed || "$read_version" != "$emulator_version" || "$read_commit" != "$emulator_commit" ]]
  then
    preflight_error "the product build's emulator is $read_version ($read_commit), the run's image is $emulator_version ($emulator_commit)"
  fi
fi
docker run -d --pull never --name "$container" --label "emuforge-it-run=$run_id" --memory 2g \
  -p "127.0.0.1:$EMULATOR_PORT:$EMULATOR_PORT" -e "HOME=$HOME" -v "$HOME/.aws/emulator:$HOME/.aws/emulator" \
  "aws-emulator:it-$run_id" -p "$EMULATOR_PORT" -t off >/dev/null \
  || preflight_error "the run's emulator would not start"
health="$(curl -q -fsS --noproxy '*' --retry-all-errors --retry 60 --retry-delay 1 --retry-max-time 30 \
  --max-time 5 --cacert "$emulator_dir/ca.pem" "https://127.0.0.1:$EMULATOR_PORT/__admin/health" 2>/dev/null || true)"
[[ "$health" == "ok" ]] || preflight_error "the run's emulator did not answer 200 ok within 30 s"
echo "integration: emulator $emulator_version ($emulator_commit) answers on 127.0.0.1:$EMULATOR_PORT" >&2

# The checks, one at a time. A left-out engine check returns at once (support::check::check reads the ids file).
if [[ "$left_out" == yes ]]; then
  export EMUFORGE_IT_NOT_RUN="$out/not-run.ids"
fi
EMUFORGE_IT_ENGINE_BIN="$engine_bin" EMUFORGE_IT_ENGINE_BUILD="$engine_build" \
  EMUFORGE_IT_VERDICTS="$out/verdicts" EMUFORGE_IT_RUN_ID="$run_id" \
  cargo test --manifest-path engine/Cargo.toml --no-fail-fast -- --test-threads=1 2>&1 | tee "$logs/integration-cargo-test.log" \
  || true
unset EMUFORGE_IT_NOT_RUN

# The Studio flow checks, one at a time, with Studio's own pinned Playwright (no second package). Without it
# (no studio/ package, or its install failed) there is nothing to run them with, and each Studio check is
# `failed` with that reason, as an engine check is without an engine. Left-out Studio and product checks are left
# out with one --grep-invert pattern.
playwright="$checkout/studio/node_modules/.bin/playwright"
grep_args=()
if [[ -n "$grep_invert" ]]; then
  grep_args=(--grep-invert "$grep_invert")
fi
if [[ -x "$playwright" && "$studio_build" != absent ]]; then
  EMUFORGE_IT_ENGINE_BIN="$engine_bin" EMUFORGE_IT_ENGINE_BUILD="$engine_build" \
    EMUFORGE_IT_STUDIO_BUILD="$studio_build" EMUFORGE_IT_VERDICTS="$out/verdicts" EMUFORGE_IT_RUN_ID="$run_id" \
    EMUFORGE_IT_PRODUCT_IMAGE="$product_image" EMUFORGE_IT_EMULATOR_IMAGE="$emulator_image" \
    EMUFORGE_IT_PRODUCT_BUILD="$product_build" EMUFORGE_IT_EMULATOR_VERSION="$emulator_version" \
    EMUFORGE_IT_EMULATOR_COMMIT="$emulator_commit" \
    NODE_PATH="$checkout/studio/node_modules" \
    "$playwright" test --config "$here/studio/playwright.config.ts" ${grep_args[@]+"${grep_args[@]}"} 2>&1 \
    | tee "$logs/integration-playwright.log" \
    || true
else
  if [[ "$studio_build" == absent ]]; then
    reason="studio/package.json does not exist"
  else
    reason="no Playwright at $playwright (studio build $studio_build, see $studio_log)"
  fi
  python3 -I - "$manifest" "$out/verdicts" "$reason" <<'PY'
import json, pathlib, sys
manifest, verdicts, reason = sys.argv[1:]
for line in pathlib.Path(manifest).read_text().splitlines():
    if line.strip() and json.loads(line)["module"] == "studio":
        check_id = json.loads(line)["check_id"]
        record = dict(check_id=check_id, verdict="failed", seconds=0, log=None, message=reason)
        (pathlib.Path(verdicts) / f"{check_id}.json").write_text(json.dumps(record))
PY
  echo "integration: $reason; every Studio check failed" >&2
fi

code="$(report)"
echo "integration: report $out/report.json, exit $code" >&2
fidelity_line
exit "$code"
