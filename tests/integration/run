#!/usr/bin/env bash
# Entry point of the integration suite; pm-check runs it as the `integration` step.
#
# Builds the engine, Studio and the product form's image (issue 34), starts the run's own aws-emulator (telemetry off) on a loopback port, runs the
# engine checks of tests/integration/engine one at a time, then the Studio flow checks of tests/integration/studio
# one at a time, stops everything it started and writes <checkout>/output/integration/report.json: emulator
# version and commit, the checkout's commit, the verdict of every manifest check (passed, failed, error) and the
# relay fidelity figure.
#
# Relay fidelity (engine/references/relay-fidelity.md): passed / total over the manifest rows labelled
# `transparency` whose verdict is passed or failed (`error` counts in neither). It is written into report.json as
# relay_fidelity {passed, total} and printed as the last line of the output:
#   relay fidelity <passed>/<total> emulator <version> commit <sha>
#
# Ports: EMULATOR_PORT, EMUFORGE_ENGINE_PORT and EMUFORGE_STUDIO_PORT when set (EMULATOR_PORT=9297, the owner's
# emulator, is refused), else a free loopback port each.
#
# Product form (issue 34): the image of the root docker-compose.yml is built once per run under the run's own
# name (emuforge-it-product-<run id>), and the run's pinned emulator image is tagged under the run's own name
# (emuforge-it-emulator-<run id>), so a check's `docker compose ... up --build` is a cache hit and never retags
# `emuforge` or `aws-emulator`. Both names are removed at the end, with every container started from them.
#
# Exit: 0 when every check passed; 1 when any failed; 127 when there are only errors (the environment failed:
# Docker, the image, cargo, bun; pm-check records 127 as `error`). The engine and Studio are the subject, not the
# environment: when engine/ or studio/ does not exist or does not build, every check still runs and fails at its
# first engine or Studio step.
set -euo pipefail

# Real AWS credentials, profiles and proxy settings never reach a check.
for name in $(compgen -e); do
  case "$name" in
    AWS_* | http_proxy | https_proxy | HTTP_PROXY | HTTPS_PROXY | all_proxy | ALL_PROXY | no_proxy | NO_PROXY)
      unset "$name" ;;
  esac
done
unset EMUFORGE_IT_ENGINE_BIN EMUFORGE_IT_ENGINE_BUILD EMUFORGE_IT_STUDIO_BUILD EMUFORGE_IT_VERDICTS EMUFORGE_IT_RUN_ID
unset EMUFORGE_IT_PRODUCT_IMAGE EMUFORGE_IT_EMULATOR_IMAGE EMUFORGE_IT_PRODUCT_BUILD EMUFORGE_IT_EMULATOR_VERSION
unset EMUFORGE_IT_EMULATOR_COMMIT EMUFORGE_IMAGE EMUFORGE_EMULATOR_IMAGE
unset NODE_OPTIONS NODE_PATH
export AWS_EC2_METADATA_DISABLED=true

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$here"
checkout="$(cd ../.. && pwd)"
out="$checkout/output/integration"
logs="$checkout/output/logs"
rm -rf "$out/verdicts" "$out/logs" "$out/tmp" "$out/playwright" "$out/report.json"
mkdir -p "$out/verdicts" "$logs"
run_id="$(date +%s)-$$"
product_image="emuforge-it-product-$run_id"
emulator_image="emuforge-it-emulator-$run_id"
commit="$(git -C "$checkout" rev-parse HEAD 2>/dev/null || echo unknown)"
emulator_version=unknown
emulator_commit=unknown

# report <reason>: writes report.json from the manifest and the verdict files and prints the exit code. With a
# reason, the run did not get to its checks and every check is `error` with that reason.
report() {
  python3 -I - "$here/manifest.jsonl" "$out/verdicts" "$out/report.json" \
    "$emulator_version" "$emulator_commit" "$commit" "${1:-}" <<'PY'
import json, pathlib, sys
manifest, verdicts, report, version, emulator_commit, commit, reason = sys.argv[1:]
checks = []
transparency = set()
for line in pathlib.Path(manifest).read_text().splitlines():
    if not line.strip():
        continue
    row = json.loads(line)
    check_id = row["check_id"]
    if "transparency" in row.get("labels", []):
        transparency.add(check_id)
    record = pathlib.Path(verdicts) / f"{check_id}.json"
    if reason:
        entry = dict(check_id=check_id, verdict="error", seconds=0, log=None, message=reason)
    elif record.exists():
        v = json.loads(record.read_text())
        entry = dict(check_id=check_id, verdict=v["verdict"], seconds=v["seconds"], log=v["log"], message=v.get("message", ""))
    else:
        entry = dict(check_id=check_id, verdict="error", seconds=0, log=None, message="the check wrote no verdict")
    checks.append(entry)
counted = [c for c in checks if c["check_id"] in transparency and c["verdict"] in ("passed", "failed")]
fidelity = dict(passed=sum(c["verdict"] == "passed" for c in counted), total=len(counted))
pathlib.Path(report).write_text(json.dumps(dict(
    emulator_version=version, emulator_commit=emulator_commit, commit=commit, relay_fidelity=fidelity,
    checks=checks), indent=1) + "\n")
for c in checks:
    print(f"  {c['verdict']:7} {c['check_id']}  {c['message'].splitlines()[0][:160] if c['message'] else ''}", file=sys.stderr)
verdicts = {c["verdict"] for c in checks}
print(0 if verdicts == {"passed"} else 1 if "failed" in verdicts else 127)
PY
}

# fidelity_line: the last line of every run, from report.json.
fidelity_line() {
  python3 -I - "$out/report.json" <<'PY' >&2
import json, sys
r = json.load(open(sys.argv[1]))
f = r["relay_fidelity"]
print(f"relay fidelity {f['passed']}/{f['total']} emulator {r['emulator_version']} commit {r['commit']}")
PY
}

preflight_error() {
  echo "integration: $1" >&2
  report "$1" >/dev/null
  echo "integration: report $out/report.json" >&2
  fidelity_line
  exit 127
}

free_port() {
  python3 -I -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])'
}

# Ports.
if [[ "${EMULATOR_PORT:-}" == "9297" ]]; then
  echo "integration: EMULATOR_PORT=9297 is the owner's emulator; use another port or leave it unset" >&2
  exit 1
fi
EMULATOR_PORT="${EMULATOR_PORT:-$(free_port)}"
EMUFORGE_ENGINE_PORT="${EMUFORGE_ENGINE_PORT:-$(free_port)}"
EMUFORGE_STUDIO_PORT="${EMUFORGE_STUDIO_PORT:-$(free_port)}"
export EMULATOR_PORT EMUFORGE_ENGINE_PORT EMUFORGE_STUDIO_PORT
echo "integration: run $run_id, emulator port $EMULATOR_PORT, engine port $EMUFORGE_ENGINE_PORT," \
  "studio port $EMUFORGE_STUDIO_PORT" >&2

# Preflight: the environment, not the subject.
docker info >/dev/null 2>&1 || preflight_error "docker does not answer"
docker compose version >/dev/null 2>&1 || preflight_error "docker compose does not answer"
docker image inspect aws-emulator >/dev/null 2>&1 \
  || preflight_error "image aws-emulator is missing: docker compose -f infra/aws-emulator/docker-compose.yml build"
for tool in cargo curl shasum; do
  command -v "$tool" >/dev/null 2>&1 || preflight_error "$tool is not on PATH"
done
studio_manifest="$checkout/studio/package.json"
if [[ -f "$studio_manifest" ]]; then
  for tool in bun node; do
    command -v "$tool" >/dev/null 2>&1 || preflight_error "$tool is not on PATH"
  done
fi

# The engine under test.
engine_manifest="$checkout/engine/Cargo.toml"
target_dir="$checkout/engine/target"
if [[ -f "$engine_manifest" ]]; then
  if metadata="$(cargo metadata --manifest-path "$engine_manifest" --format-version 1 --no-deps 2>/dev/null)"; then
    target_dir="$(python3 -I -c 'import json, sys; print(json.load(sys.stdin)["target_directory"])' <<<"$metadata")"
  fi
  if cargo build --manifest-path "$engine_manifest" --bin emuforge-server >"$logs/integration-engine-build.log" 2>&1; then
    engine_build=ok
  else
    engine_build=failed
    echo "integration: engine build failed, see $logs/integration-engine-build.log" >&2
  fi
else
  engine_build=absent
  echo "integration: $engine_manifest does not exist; every check will fail at its first engine step" >&2
fi
engine_bin="$target_dir/debug/emuforge-server"

# Studio under test: its locked dependencies and its production build, which the flow checks serve with
# `bun run serve`. Install and build write one log.
studio_log="$logs/integration-studio-build.log"
if [[ -f "$studio_manifest" ]]; then
  if (cd "$checkout/studio" && bun install --frozen-lockfile && bun run build) >"$studio_log" 2>&1; then
    studio_build=ok
  else
    studio_build=failed
    echo "integration: studio install or build failed, see $studio_log" >&2
  fi
else
  studio_build=absent
  echo "integration: $studio_manifest does not exist; every Studio check will fail at its first Studio step" >&2
fi

# The emulator version, pinned for the run.
version_text="$(docker run --rm --entrypoint aws-emulator aws-emulator --version 2>&1)" \
  || preflight_error "aws-emulator --version failed"
emulator_version="$(sed -n 's/^Version: *//p' <<<"$version_text")"
emulator_commit="$(sed -n 's/^Commit: *//p' <<<"$version_text")"

# The run's emulator.
emulator_dir="$HOME/.aws/emulator/$EMULATOR_PORT"
[[ -e "$emulator_dir" ]] \
  && preflight_error "$emulator_dir already exists; a leftover would be mistaken for this run's files"
container="emuforge-it-$EMULATOR_PORT-$run_id"
cleanup() {
  docker stop -t 10 "$container" >/dev/null 2>&1 || true
  docker rm -f "$container" >/dev/null 2>&1 || true
  # Containers a check started and could not remove (the test process was killed).
  local left
  left="$(docker ps -aq --filter "label=emuforge-it-run=$run_id" 2>/dev/null || true)"
  if [[ -n "$left" ]]; then
    # A killed container leaves its keys and ca.pem behind. Each one's directory did not exist when its check took
    # the port (the name is emuforge-it-<port>-<run id>), so it is removed with the container.
    local names name port
    names="$(docker inspect -f '{{.Name}}' $left 2>/dev/null || true)"
    docker rm -f $left >/dev/null 2>&1 || true
    for name in $names; do
      port="${name#/emuforge-it-}"
      port="${port%%-*}"
      if [[ "$port" =~ ^[0-9]+$ && -e "$HOME/.aws/emulator/$port" ]]; then
        rm -rf "$HOME/.aws/emulator/$port"
      fi
    done
  fi
  # A clean stop deletes the files; a kill would leave them. The directory did not exist before this run.
  if [[ -e "$emulator_dir" ]]; then
    rm -rf "$emulator_dir"
  fi
  # The product forms a check started and could not remove: every container of the run's two images, the
  # networks of their Compose projects, and the files a killed situation 4 emulator left under the run's HOME.
  local product projects project name source port
  product="$( (docker ps -aq --filter "ancestor=$product_image"; docker ps -aq --filter "ancestor=$emulator_image") \
    2>/dev/null | sort -u || true)"
  if [[ -n "$product" ]]; then
    projects="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project"}}' $product 2>/dev/null \
      | sort -u || true)"
    while read -r name source; do
      port="${name##*-}"
      if [[ "$name" == /emuforge-app-aws-emulator-* && "$port" =~ ^[0-9]+$ && "$source" == "$HOME/.aws/emulator" \
        && -e "$HOME/.aws/emulator/$port" ]]; then
        rm -rf "$HOME/.aws/emulator/$port"
      fi
    done < <(docker inspect -f '{{.Name}} {{range .Mounts}}{{.Source}}{{end}}' \
      $(docker ps -aq --filter "ancestor=$emulator_image" 2>/dev/null) 2>/dev/null || true)
    docker rm -f $product >/dev/null 2>&1 || true
    for project in $projects; do
      docker network rm $(docker network ls -q --filter "label=com.docker.compose.project=$project") \
        >/dev/null 2>&1 || true
    done
  fi
  docker image rm "$product_image" "$emulator_image" >/dev/null 2>&1 || true
  rm -rf "$out/tmp"
}
trap cleanup EXIT
# The product form's images: the run's tag of its pinned emulator, then the product image, built once with the
# root docker-compose.yml under the run's name. A missing file or a failed build is the subject's, not the
# environment's: every product check still runs and fails at its start command, as the engine checks do without an
# engine.
docker tag aws-emulator "$emulator_image" || preflight_error "cannot tag aws-emulator as $emulator_image"
product_log="$logs/integration-product-build.log"
if [[ -f "$checkout/docker-compose.yml" ]]; then
  if (cd "$checkout" && EMUFORGE_IMAGE="$product_image" EMUFORGE_EMULATOR_IMAGE="$emulator_image" \
    docker compose --progress plain build) >"$product_log" 2>&1; then
    product_build=ok
  else
    product_build=failed
    echo "integration: product image build failed, see $product_log" >&2
  fi
else
  product_build=absent
  echo "integration: $checkout/docker-compose.yml does not exist; every product check will fail at its start" >&2
  echo "$checkout/docker-compose.yml does not exist" >"$product_log"
fi
docker run -d --name "$container" --label "emuforge-it-run=$run_id" --memory 2g \
  -p "127.0.0.1:$EMULATOR_PORT:$EMULATOR_PORT" -e "HOME=$HOME" -v "$HOME/.aws/emulator:$HOME/.aws/emulator" \
  aws-emulator -p "$EMULATOR_PORT" -t off >/dev/null \
  || preflight_error "the run's emulator would not start"
health="$(curl -q -fsS --noproxy '*' --retry-all-errors --retry 60 --retry-delay 1 --retry-max-time 30 \
  --max-time 5 --cacert "$emulator_dir/ca.pem" "https://127.0.0.1:$EMULATOR_PORT/__admin/health" 2>/dev/null || true)"
[[ "$health" == "ok" ]] || preflight_error "the run's emulator did not answer 200 ok within 30 s"
echo "integration: emulator $emulator_version ($emulator_commit) answers on 127.0.0.1:$EMULATOR_PORT" >&2

# The checks, one at a time.
EMUFORGE_IT_ENGINE_BIN="$engine_bin" EMUFORGE_IT_ENGINE_BUILD="$engine_build" \
  EMUFORGE_IT_VERDICTS="$out/verdicts" EMUFORGE_IT_RUN_ID="$run_id" \
  cargo test --manifest-path engine/Cargo.toml --no-fail-fast -- --test-threads=1 2>&1 | tee "$logs/integration-cargo-test.log" \
  || true

# The Studio flow checks, one at a time, with Studio's own pinned Playwright (no second package). Without it
# (no studio/ package, or its install failed) there is nothing to run them with, and each Studio check is
# `failed` with that reason, as an engine check is without an engine.
playwright="$checkout/studio/node_modules/.bin/playwright"
if [[ -x "$playwright" && "$studio_build" != absent ]]; then
  EMUFORGE_IT_ENGINE_BIN="$engine_bin" EMUFORGE_IT_ENGINE_BUILD="$engine_build" \
    EMUFORGE_IT_STUDIO_BUILD="$studio_build" EMUFORGE_IT_VERDICTS="$out/verdicts" EMUFORGE_IT_RUN_ID="$run_id" \
    EMUFORGE_IT_PRODUCT_IMAGE="$product_image" EMUFORGE_IT_EMULATOR_IMAGE="$emulator_image" \
    EMUFORGE_IT_PRODUCT_BUILD="$product_build" EMUFORGE_IT_EMULATOR_VERSION="$emulator_version" \
    EMUFORGE_IT_EMULATOR_COMMIT="$emulator_commit" \
    NODE_PATH="$checkout/studio/node_modules" \
    "$playwright" test --config "$here/studio/playwright.config.ts" 2>&1 | tee "$logs/integration-playwright.log" \
    || true
else
  if [[ "$studio_build" == absent ]]; then
    reason="studio/package.json does not exist"
  else
    reason="no Playwright at $playwright (studio build $studio_build, see $studio_log)"
  fi
  python3 -I - "$here/manifest.jsonl" "$out/verdicts" "$reason" <<'PY'
import json, pathlib, sys
manifest, verdicts, reason = sys.argv[1:]
for line in pathlib.Path(manifest).read_text().splitlines():
    if line.strip() and json.loads(line)["module"] == "studio":
        check_id = json.loads(line)["check_id"]
        record = dict(check_id=check_id, verdict="failed", seconds=0, log=None, message=reason)
        (pathlib.Path(verdicts) / f"{check_id}.json").write_text(json.dumps(record))
PY
  echo "integration: $reason; every Studio check failed" >&2
fi

code="$(report)"
echo "integration: report $out/report.json, exit $code" >&2
fidelity_line
exit "$code"
