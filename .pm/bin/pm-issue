#!/usr/bin/env -S python3 -I
"""Create, list and close issue files under issues/ (format: issues/README.md).

  pm-issue new --module M --kind K --severity S --source SRC --key KEY --title "Imperative title" [--in CHECKOUT]
  pm-issue list [--all]
  pm-issue show <id>
  pm-issue close <id> [--checks "<check id> ..."] [--in CHECKOUT]
  pm-issue commit [--in CHECKOUT] [--dry-run]

new    writes issues/things-that-do-not-work/<UTC timestamp>-<slug>.md with the header filled in and the body
       sections empty, assigns the next Issue-Id, and refuses a duplicate Issue-Key. Prints the id and the path.
       The PM and a plan pane file in the main checkout; a worker files with --in <its worktree> and commits the
       file on its branch, so it reaches main when the unit merges.
close  moves the file to issues/things-that-now-work/ with `git mv` and sets Issue-Check-Ids. --checks is needed
       but for an issue whose Issue-Module is harness (issue 523): without it the header reads `Issue-Check-Ids: none
       (harness issue, no kept guard shows it)`. It changes nothing
       else in the file and does not commit: the move belongs in the commit that fixes the issue, so run it with
       --in <worktree> inside the unit that closes the issue.
commit commits every issue file under issues/things-that-do-not-work/ that is new in the checkout (untracked or
       added, not yet committed) and nothing else, with the message `issue: file #<id> #<id> …` built from the
       files' own Issue-Id headers. Refuses a file whose Description or Evidence section is empty. Never type
       this commit by hand: the message then names every filed issue, and only those.
Ids are assigned from the main checkout so two worktrees never pick the same one.
"""
import argparse
import datetime as dt
import os
import pathlib
import re
import subprocess
import sys

NO_GUARD = "none (harness issue, no kept guard shows it)"  # Issue-Check-Ids of a harness issue closed without ids
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _pmlib import ROOT, RUN, guard

OPEN, DONE = "issues/things-that-do-not-work", "issues/things-that-now-work"
MODULES = ("studio", "engine", "cli", "iam", "verify", "harness")
KINDS = ("gap", "bug", "feature")
SEVERITIES = ("CRITICAL", "HIGH", "MEDIUM", "LOW")
BODY = """
# {title}

> Identified against commit `{commit}`. The code may have drifted since; trace the issue to the current code before fixing.

## Description

## Evidence

## Steps to Reproduce

## Expected

## Out of scope
"""


def header(path):
    h = {}
    for line in path.read_text(errors="replace").splitlines():
        m = re.match(r"^(Issue-[A-Za-z-]+):\s*(.*)$", line)
        if not m:
            break
        h[m.group(1)] = m.group(2).strip()
    return h


def files(base, which=(OPEN, DONE)):
    for d in which:
        for f in sorted((base / d).glob("*.md")):
            yield d, f, header(f)


def find(base, issue_id):
    for d, f, h in files(base):
        if h.get("Issue-Id") == str(issue_id):
            return d, f, h
    sys.exit(f"no issue file with Issue-Id {issue_id} in {base}")


def cmd_new(a):
    base = pathlib.Path(a.checkout).resolve() if a.checkout else ROOT
    if not re.fullmatch(r"[a-z]+\|[^|\s]+\|[^|\s]+", a.key):
        sys.exit("--key must be <module>|<subject>|<class> without spaces")
    known = list(files(ROOT)) + (list(files(base)) if base != ROOT else [])
    dup = next((f for _, f, h in known if h.get("Issue-Key") == a.key), None)
    if dup:
        sys.exit(f"duplicate Issue-Key {a.key}: {dup}")
    # ids come from one counter in the main checkout, so two worktrees filing at the same time never collide
    seq = RUN / "issue-seq"
    last = int(seq.read_text().strip() or 0) if seq.exists() else 0
    next_id = max([int(h["Issue-Id"]) for _, _, h in known if h.get("Issue-Id", "").isdigit()] + [last]) + 1
    seq.write_text(str(next_id))
    commit = subprocess.run(["git", "-C", str(base), "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip() or "(no commit yet)"
    slug = re.sub(r"[^a-z0-9]+", "-", a.title.lower()).strip("-")[:80]
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    path = base / OPEN / f"{stamp}-{a.module}-{slug}.md"
    head = (f"Issue-Id: {next_id}\nIssue-Severity: {a.severity}\nIssue-Module: {a.module}\nIssue-Kind: {a.kind}\n"
            f"Issue-Source: {a.source}\nIssue-Key: {a.key}\nIssue-Check-Ids:\nIssue-Commit: {commit}\n")
    path.write_text(head + BODY.format(title=a.title, commit=commit))
    print(f"{next_id} {path}")


def cmd_list(a):
    for d, f, h in files(ROOT, (OPEN, DONE) if a.all else (OPEN,)):
        state = "open" if d == OPEN else "done"
        print(f"  #{h.get('Issue-Id', '?'):>3} {state:4} {h.get('Issue-Severity', ''):8} {h.get('Issue-Module', ''):7} {h.get('Issue-Kind', ''):7} {h.get('Issue-Source', ''):10} {f.name}")


def cmd_show(a):
    _, f, _ = find(ROOT, a.id)
    print(f)
    print(f.read_text(errors="replace"))


def cmd_close(a):
    base = pathlib.Path(a.checkout).resolve() if a.checkout else ROOT
    d, f, h = find(base, a.id)
    if d == DONE:
        sys.exit(f"#{a.id} is already in {DONE}")
    checks = " ".join((a.checks or "").split())
    text = f.read_text()
    if not checks:
        if not re.search(r"(?m)^Issue-Module:[ \t]*harness[ \t]*$", text):
            sys.exit("--checks must name at least one check id: an issue is closed by its checks, not by a statement "
                     "(only a harness issue closes without one)")
        checks = NO_GUARD
    text, n = re.subn(r"(?m)^Issue-Check-Ids:.*$", f"Issue-Check-Ids: {checks}", text, count=1)
    if n != 1:
        sys.exit(f"{f} has no Issue-Check-Ids header line")
    f.write_text(text)
    target = base / DONE / f.name
    r = subprocess.run(["git", "-C", str(base), "mv", str(f), str(target)], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"git mv failed: {r.stderr.strip()}")
    subprocess.run(["git", "-C", str(base), "add", str(target)], capture_output=True)
    print(f"closed #{a.id}: {target} (staged; commit it with the fix)")


def section(text, name):
    m = re.search(rf"(?ms)^## {re.escape(name)}\s*$(.*?)(?=^## |\Z)", text)
    return m.group(1).strip() if m else ""


def cmd_commit(a):
    if not a.checkout:
        guard("pm-issue commit without --in (a commit on main)")  # a pane commits in its own checkout (issue 478)
    base = pathlib.Path(a.checkout).resolve() if a.checkout else ROOT
    git = lambda *args: subprocess.run(["git", "-C", str(base), *args], capture_output=True, text=True)
    new = []
    for line in git("status", "--porcelain", "--untracked-files=all", "--", OPEN).stdout.splitlines():
        status, path = line[:2], line[3:].strip().strip('"')
        if path.endswith(".md") and (status == "??" or "A" in status):
            new.append(base / path)
    if not new:
        sys.exit(f"no new issue file under {OPEN} in {base}")
    ids, problems = [], []
    for f in sorted(new):
        h, text = header(f), f.read_text(errors="replace")
        if not h.get("Issue-Id", "").isdigit():
            problems.append(f"{f.name}: no Issue-Id (create issue files with pm-issue new)")
            continue
        ids.append(int(h["Issue-Id"]))
        for name in ("Description", "Evidence"):
            if not section(text, name):
                problems.append(f"{f.name} (#{h['Issue-Id']}): the {name} section is empty")
    if len(set(ids)) != len(ids):
        problems.append(f"the same Issue-Id appears twice: {sorted(ids)}")
    if problems:
        sys.exit("cannot commit:\n- " + "\n- ".join(problems))
    message = "issue: file " + " ".join(f"#{i}" for i in sorted(ids))
    if a.dry_run:
        print(f"would commit {len(new)} file(s): {message}")
        return
    paths = [str(f) for f in sorted(new)]
    r = git("add", "--", *paths)
    if r.returncode == 0:
        r = git("commit", "-q", "--only", "-m", message, "--", *paths)  # nothing else that happens to be staged
    if r.returncode != 0:
        sys.exit(f"git failed: {(r.stderr or r.stdout).strip()}")
    print(f"{git('rev-parse', '--short', 'HEAD').stdout.strip()} {message}")


p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
sp = p.add_subparsers(dest="cmd", required=True)
x = sp.add_parser("new"); x.add_argument("--module", required=True, choices=MODULES); x.add_argument("--kind", required=True, choices=KINDS)
x.add_argument("--severity", required=True, choices=SEVERITIES); x.add_argument("--source", required=True, help="github#<n> | owner | finder | plan | worker")
x.add_argument("--key", required=True); x.add_argument("--title", required=True); x.add_argument("--in", dest="checkout"); x.set_defaults(f=cmd_new)
x = sp.add_parser("list"); x.add_argument("--all", action="store_true"); x.set_defaults(f=cmd_list)
x = sp.add_parser("show"); x.add_argument("id"); x.set_defaults(f=cmd_show)
x = sp.add_parser("close"); x.add_argument("id"); x.add_argument("--checks"); x.add_argument("--in", dest="checkout"); x.set_defaults(f=cmd_close)
x = sp.add_parser("commit"); x.add_argument("--in", dest="checkout"); x.add_argument("--dry-run", action="store_true"); x.set_defaults(f=cmd_commit)
a = p.parse_args()
a.f(a)
