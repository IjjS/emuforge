#!/usr/bin/env -S python3 -I
"""Open, list, reset and close agent panes inside the issue's herdr tab.

  pm-pane new <issue> <role> [--unit U] [--kind claude|codex] [--model opus|fable|sonnet|<id>]
                              [--effort low|medium|high|xhigh|max] [--cwd PATH] [--brief FILE] [--text TEXT] [--no-limit]
  pm-pane reset <name> [--wait S] state file -> /clear -> brief again (run on EVENT ctx <name>)

reset asks the pane to write its resume note (a worker's and a harness-engineer's output/state.md, every other role's
.pm/issue-<id>/state-<role>.md) and end its turn with the typed line `RESET READY <name> <nonce>`: reported with
pm-report, then printed. It waits up to --wait seconds (420) for that marker: as the pane's pm-report record of the
line, or, for a pane that only prints it, in the pane's reply, however many rows stand before it and however the pane's width wraps it, never in the echo
of its own prompt; whichever comes first. It reads the pane's snapshot
every 2 s and matches it itself, since herdr's `pane wait-output` matches row by row (issue 509). While it runs, the
pane's registry entry holds `resetting`, so pm-watchd takes the reset's own turn ends for no silent turn.
  pm-pane close <name> | --issue <issue>
  pm-pane list

reset and close also stop the orphaned processes of the pane's worktree: its processes whose parent is a reaper
(PID 1), as a test runner's workers left by a kill of the runner. reset sweeps after /clear and before the brief;
close after the pane is closed, looking again for up to 5 s. Each prints one line per worktree: `stopped <n>
orphaned processes of <worktree>: <pid> <name>, …`, `no orphaned processes in <worktree>` or `cannot tell …`, and
logs it. Only processes of the worktree are signalled, by PID after a check that each is still the same process;
nothing by name, no process group, no container. A pane in the main checkout is not swept. What the sweep leaves
out (_pmorphans: a running pm-check of the worktree, its step group and the stand-ins its tests start under
<worktree>/output/tests/, and impeccable's live-server while a live crit pane of the worktree's issue is
registered) is not signalled, and the line says so: `…; left running: <pid> <name>, … (<why>)`.

Roles: plan, worker, rev, crit, harness-engineer. Name = i<issue>-<role>[-<unit>], e.g. i12-plan, i12-worker-s1, i12-rev,
i12-harness-engineer (herdr names must start with a letter).
Who may run it: the pm, and a plan for its own issue: `new <its issue> worker|rev|crit`, and `reset` and `close` of a
pane of its own issue other than itself (by name). Every other pane is refused all but `list`. A plan answered QUEUE
is remembered in .pm/run/waiting.json and pm-watchd prompts it `EVENT room <plan> pane <role> <side>` once there is room.
A unit name starts with its side: s<n> studio, e<n> engine, t<n> tests, h<n> harness.
Tab: "#<issue>" in the PM's workspace; created when missing. New agents are panes inside that tab.
Limits (enforced unless --no-limit): worker panes per side (studio 8, engine 8, tests 8, harness 8), total live panes 24,
memory 22.5 GB, swap free 256 MB, CPU 90%, and the Claude token rate of the last hour under today's target when one is set (pm-tokens).
Default: claude on opus. Any pane takes --kind/--model (the PM passes what the owner chose at session start).
Effort: --effort goes to the agent as the model does (claude --effort <level>, after the -- of herdr agent start);
a plan may pass it for its own panes. A pane opened again under a name it had (a rev opened for each review round,
a pane reopened after EVENT gone) gets the kind, model and effort it had when not given (the registry and
.pm/run/panes-history.jsonl remember them; its model only when its kind is the same, issue 557); a new one claude on
opus at its role's effort: plan, rev, crit and harness-engineer high, worker medium. A codex pane takes no effort: --effort is ignored, with one line saying so. The brief is sent as: "Read <FILE> and follow it. Your pane name is <name>."
To talk to a pane use herdr directly: herdr agent prompt <name> "<text>" (it refuses a pane blocked at a dialog).
--adopt (the pm's) registers an agent herdr already runs under the exact name, cwd and kind (one left after a startup
trust dialog, or one the registry lost: EVENT unregistered); its --brief is recorded and not sent, since the agent
already runs, and the line it prints says how to send it by hand when the agent never got it.
The registry (.pm/run/panes.json) and pm.json are changed only under their lock (_pmlib.update), each change applied
to the file as it is at that moment, so pm-pane calls at the same moment, from any process, lose no pane (issue 504).
While new starts an agent and until its entry is in, and while close takes entries out and closes their panes, the
pane's name is marked as being opened or closed (.pm/run/pane-ops/<name>), so pm-watchd does not tell it as
unregistered; the mark goes, and pm-watchd is woken, when the command ends however it ends. herdr lists a closed
pane's agent for a moment after the close, so close keeps its marks until herdr lists no agent in the panes it closed,
at most 5 s, and logs each agent herdr still lists then (issue 510).
"""
import argparse
import contextlib
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _pmlib import (LIMITS, MODEL_IDS, PANE_ROLES, PANES, PANES_HISTORY, PLAN_OPENS, PMINFO, ROOT, agent_by_name, cpu_pct,
                    find_key, guard, herdr, herdr_text, load, log, mark_resetting, mem_gb, now, pane_op, panes, reported_after,
                    reports_size, reset_marker_seen, room, side_of, state_note, tabs, update, wait_for_room)
from _pmorphans import line, sweep, worktree_paths


CLOSE_SETTLE = 5  # seconds a close waits for herdr to stop listing the closed panes' agents (issue 510)


def registry():
    """Registry with entries whose pane disappeared marked gone (the daemon reports them; close removes them). herdr
    is asked first; the marks are set under the registry's lock on the registry as it is then (issue 504)."""
    plist = panes()
    if plist is None:  # herdr did not answer: judge nothing
        return load(PANES, [])
    existing = {p["pane_id"] for p in plist}
    with update(PANES, []) as reg:
        for r in reg:
            gone = r["pane_id"] not in existing
            if gone != bool(r.get("gone")):
                r["gone"] = gone
    return reg


def live(reg):
    return [r for r in reg if not r.get("gone")]


def worktree_of(cwd):
    """(name, path) of the registered worktree whose path is the pane's cwd, or None (the main checkout among them)."""
    if not isinstance(cwd, str):
        return None
    real = os.path.realpath(cwd)
    return next((w for w in worktree_paths() if w[1] == real), None)


def sweep_worktrees(wts, settle_min=0):
    """Stop the orphaned processes of each worktree; print and log one line per worktree."""
    if not wts:
        return
    result = sweep(wts, settle_min=settle_min)
    for name, _ in wts:
        text = line(name, result[name])
        print(text)
        log("orphans " + text)


def issue_tab(issue, workspace):
    label = f"#{issue}"
    for t in tabs():
        if t.get("label") == label and (not workspace or t.get("workspace_id") == workspace):
            return t["tab_id"], False
    args = ["tab", "create", "--cwd", str(ROOT), "--label", label, "--no-focus"]
    if workspace:
        args += ["--workspace", workspace]
    r = herdr(*args)
    tab_id = find_key(r, "tab_id")
    if not tab_id:
        sys.exit(f"tab create returned no tab_id: {r}")
    time.sleep(0.5)
    return tab_id, True


def shell_pane_in(tab_id, cwd, fresh):
    """Return a pane id at a shell prompt inside the tab: the fresh tab's own pane, or a new split."""
    in_tab = [p for p in (panes() or []) if p.get("tab_id") == tab_id]
    if fresh and len(in_tab) == 1 and not in_tab[0].get("agent"):
        pid = in_tab[0]["pane_id"]
        if cwd != str(ROOT):
            herdr("pane", "run", pid, f"cd {cwd}", check=False)
            time.sleep(0.5)
        return pid
    if not in_tab:
        sys.exit(f"tab {tab_id} has no panes")
    anchor = sorted(in_tab, key=lambda p: p["pane_id"])[-1]["pane_id"]
    direction = "right" if len(in_tab) % 2 == 1 else "down"
    r = herdr("pane", "split", "--pane", anchor, "--direction", direction, "--cwd", cwd, "--no-focus")
    pid = find_key(r, "pane_id")
    if not pid:
        sys.exit(f"pane split returned no pane_id: {r}")
    time.sleep(0.7)
    return pid


def session_of(name, tries=10):
    for _ in range(tries):
        ag = agent_by_name(name) or {}
        s = (ag.get("agent_session") or {}).get("value")
        if s:
            return s
        time.sleep(1)
    return None


def record_history(entry):
    with open(PANES_HISTORY, "a") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")


def brief_text(entry, resumed=False):
    t = f"Read {entry['brief']} and follow it. Your pane name is {entry['name']}."
    if resumed:
        t += " You were reset for context size: resume from the state file your brief names; do not redo finished work."
    return t


EFFORTS = ("low", "medium", "high", "xhigh", "max")
KINDS = ("claude", "codex")
EFFORT_BY_ROLE = {"plan": "high", "rev": "high", "crit": "high", "harness-engineer": "high", "worker": "medium"}


def last_opened(name, old):
    """The pane of this name as it was when last opened: its registry entry, else its last history line, else {}."""
    if old:
        return old
    last = {}
    try:
        with open(PANES_HISTORY) as f:
            for ln in f:
                try:
                    r = json.loads(ln)
                except json.JSONDecodeError:
                    continue
                if isinstance(r, dict) and r.get("name") == name:
                    last = r
    except OSError:
        pass
    return last


def kind_and_model(a, before):
    """The kind and model id a pane is started with (issue 557): --kind, else the kind it had, else claude; --model,
    else the model it had when the kind is the one it had, else Opus for claude and none for codex."""
    kind = a.kind or (before.get("kind") if before.get("kind") in KINDS else None) or "claude"
    if a.model:
        return kind, MODEL_IDS.get(a.model, a.model)
    if before.get("model") and before.get("kind") == kind:
        return kind, before["model"]
    return kind, (MODEL_IDS["opus"] if kind == "claude" else None)


def effort_of(a, before):
    """The effort a claude pane is started with: --effort, else the one it had, else its role's; None for codex."""
    if a.kind != "claude":
        if a.effort:
            print(f"effort {a.effort} ignored: a {a.kind} pane takes no effort")
        return None
    had = before.get("effort") if before.get("kind", "claude") == "claude" else None
    return a.effort or (had if had in EFFORTS else None) or EFFORT_BY_ROLE.get(a.role)


def queue(asker, a, side, why, tail=""):
    """Answer QUEUE; a pane that asked is remembered, so pm-watchd tells it when there is room."""
    if asker:
        wait_for_room(asker["name"], a.role, side, a.issue, why)
        tail = f"; end your turn: EVENT room {asker['name']} pane {a.role} {side} comes when there is room"
    sys.exit(f"QUEUE: {why}{tail}")


def own_pane(asker, name, reg):
    """For a plan: the pane it names must be of its own issue and not itself."""
    if asker is None:
        return
    entry = next((r for r in reg if r["name"] == name), None)
    if not entry or entry.get("issue") != str(asker.get("issue")) or name == asker["name"]:
        sys.exit(f"refused: {asker['name']} resets and closes only the worker, rev and crit panes of #{asker.get('issue')}; not {name}")


def cmd_new(a):
    """Open a pane. From before the agent starts until its entry is in the registry, the pane's name is marked as being
    opened (_pmlib.pane_op), so pm-watchd does not take it for a pane the registry lost."""
    name = f"i{a.issue}-{a.role}" + (f"-{a.unit}" if a.unit else "")
    with pane_op(name):
        new(a, name)


def new(a, name):
    asker = guard(f"pm-pane new {a.issue} {a.role}", issue=a.issue, plan_may=True)
    if asker and a.role not in PLAN_OPENS:
        sys.exit(f"refused: a plan opens only {', '.join(PLAN_OPENS)} panes; {a.role} is the pm's")
    if asker and (a.no_limit or a.adopt):
        sys.exit("refused: --no-limit and --adopt are the pm's")
    side = side_of(a.unit)
    from _pmquota import start_allowed
    quota_reason = start_allowed(a.issue)
    if quota_reason:
        queue(asker, a, side, quota_reason)
    reg = registry()
    existing = agent_by_name(name)
    if existing and not a.adopt:
        sys.exit(f"agent {name} already exists")
    if a.adopt and not existing:
        sys.exit(f"no launched agent {name} to adopt")
    old = next((r for r in reg if r["name"] == name), None)
    reg = [r for r in reg if r["name"] != name]  # a gone entry of the same name is replaced
    # a name opened again (a rev for its next round, a pane reopened after EVENT gone) keeps its kind, model and
    # effort unless they are given (issue 557)
    before = last_opened(name, old)
    a.kind, model = kind_and_model(a, before)
    cwd = os.path.abspath(a.cwd or str(ROOT))
    if a.adopt and (os.path.abspath(existing.get("cwd", "")) != cwd or existing.get("agent") != a.kind):
        sys.exit("adoption requires the exact expected cwd and agent kind")
    # the agent exited but its shell pane is still there: reuse that pane instead of splitting another
    reuse = None
    if old:
        p_old = next((p for p in (panes() or []) if p["pane_id"] == old["pane_id"]), None)
        if p_old and not p_old.get("agent"):
            reuse = old["pane_id"]
    if not a.no_limit:
        why = room(a.role, side, a.issue, alive=live(reg))
        if why:
            queue(asker, a, side, why, "; close or wait (EVENT mem ok, cpu ok, tokens ok), then retry")
    info = load(PMINFO, {})
    workspace = info.get("workspace") or os.environ.get("HERDR_WORKSPACE_ID")
    if a.adopt:
        tab_id, pane_id = existing["tab_id"], existing["pane_id"]
    elif reuse:
        tab_id, pane_id = old["tab_id"], reuse
        herdr("pane", "run", pane_id, f"cd {cwd}", check=False)
        time.sleep(0.5)
    else:
        tab_id, fresh = issue_tab(a.issue, workspace)
        pane_id = shell_pane_in(tab_id, cwd, fresh)
    args = ["agent", "start", name, "--kind", a.kind, "--pane", pane_id, "--timeout", "90000"]
    extra = []
    effort = effort_of(a, before)
    if a.kind == "claude" and model:
        extra += ["--model", model]
    if effort:
        extra += ["--effort", effort]
    if a.kind == "codex" and model:
        extra += ["-m", model]
    if extra:
        args += ["--", *extra]
    r = existing if a.adopt else herdr(*args, check=False)
    if r is None:
        sys.exit(f"agent start failed for {name} in {pane_id}; the pane is left open for inspection")
    entry = dict(name=name, issue=str(a.issue), role=a.role, unit=a.unit, kind=a.kind, model=model, effort=effort, side=side,
                 pane_id=pane_id, tab_id=tab_id, cwd=cwd, brief=(os.path.abspath(a.brief) if a.brief else None),
                 started=now(), session=session_of(name, tries=3), gone=False, resets=0)
    # added to the registry as it is now, not to the list read before the start: other pm-pane calls may have
    # added or closed panes meanwhile (issue 504)
    with update(PANES, []) as now_reg:
        now_reg[:] = [r for r in now_reg if r.get("name") != name] + [entry]
    record_history(entry)
    # remember that the current PM session worked on this issue (pm-cost shares the PM's cost between them)
    with update(PMINFO, {}) as pinfo:
        if pinfo.get("pm_session"):
            lst = pinfo.setdefault("session_issues", {}).setdefault(pinfo["pm_session"], [])
            if str(a.issue) not in lst:
                lst.append(str(a.issue))
    log(f"pane new {name} {pane_id} {a.kind} {model} effort={effort} cwd={cwd}")
    text = a.text
    if a.brief and not a.adopt:
        text = brief_text(entry) + (f" {a.text}" if a.text else "")
    elif a.brief:  # an adopted agent already runs (issue 504): its brief is recorded, not sent again
        print(f"brief recorded, not sent: {name} already runs; if it never got it: herdr agent prompt {name} \"{brief_text(entry)}\"")
    print(f"{name} {pane_id} tab={tab_id} kind={a.kind} model={model} effort={effort} session={entry['session']}")
    if text:
        herdr("agent", "wait", name, "--until", "idle", "--until", "done", "--timeout", "60000", check=False)
        if herdr("agent", "prompt", name, text, check=False) is None:
            ag = agent_by_name(name) or {}
            sys.exit(f"BRIEF NOT SENT: {name} is {ag.get('agent_status')} (a trust or setup dialog?); "
                     f"inspect with herdr agent read {name}, then herdr agent prompt {name} \"{text}\"")


def issue_of(name):
    return next((r.get("issue") for r in load(PANES, []) if r["name"] == name), None)


def wait_for_marker(name, pane_id, marker, reports_at, wait):
    """Wait up to `wait` seconds for the reset marker; return where it was seen ('on the screen', 'in pm-report') or
    None. The pane's snapshot is read every 2 s and matched here (_pmlib.reset_marker_seen): herdr's `pane
    wait-output` matches row by row, so a marker after a sentence, or wrapped over two rows, never matched there (issue
    509). A failed read is tried again until the deadline."""
    deadline = time.monotonic() + wait
    while True:
        if reported_after(reports_at, name, marker):
            return "in pm-report"
        if reset_marker_seen(herdr_text("pane", "read", pane_id, "--source", "recent-unwrapped"), marker):
            return "on the screen"
        left = deadline - time.monotonic()
        if left <= 0:
            return None
        time.sleep(min(2, left))


def wait_words(seconds):
    return f"{seconds // 60} min" if seconds % 60 == 0 else f"{seconds} s"


def cmd_reset(a):
    if a.wait < 1:
        sys.exit("--wait takes a number of seconds, 1 or more")
    asker = guard(f"pm-pane reset {a.name}", issue=issue_of(a.name), plan_may=True)
    own_pane(asker, a.name, load(PANES, []))
    reg = registry()
    entry = next((r for r in live(reg) if r["name"] == a.name), None)
    if not entry:
        sys.exit(f"no live pane {a.name}")
    if not entry.get("brief"):
        sys.exit(f"{a.name} was opened without --brief; reset by hand")
    ag = agent_by_name(a.name) or {}
    if ag.get("agent_status") == "blocked":
        sys.exit(f"{a.name} is blocked at a dialog; inspect with herdr agent read {a.name}")
    nonce = now()[11:19].replace(":", "")
    marker = f"RESET READY {a.name} {nonce}"
    mark_resetting(a.name, True)  # pm-watchd takes the turn ends of the reset (the marker's, /clear's) for no silent turn
    reports_at = reports_size()  # only a record written after the prompt counts
    herdr("agent", "prompt", a.name,
          f"Context reset requested. Write your resume note now to {state_note(entry)}: what is done, what is next, open P1s, "
          f"paths. Then end your turn with this typed line: report it with {ROOT}/.pm/bin/pm-report \"{marker}\", "
          f"print the same line and stop: {marker}")
    # Whole command stays under the Bash tool's 10-minute cap: 7 min for the note, 1 min to settle, ~30 s to re-brief.
    seen = wait_for_marker(a.name, entry["pane_id"], marker, reports_at, a.wait)
    if not seen:
        mark_resetting(a.name, False)
        sys.exit(f"{a.name} did not print the reset marker within {wait_words(a.wait)}; "
                 f"inspect with herdr agent read {a.name}, then rerun reset")
    log(f"pane reset {a.name}: marker seen {seen}")
    herdr("agent", "wait", a.name, "--until", "idle", "--until", "done", "--timeout", "60000", check=False)
    old = entry.get("session")
    herdr("agent", "prompt", a.name, "/clear")
    time.sleep(2)
    herdr("agent", "wait", a.name, "--until", "idle", "--until", "done", "--timeout", "30000", check=False)
    new = None
    for _ in range(10):
        s = session_of(a.name, tries=1)
        if s and s != old:
            new = s
            break
        time.sleep(1)
    # the agent has settled after /clear: what its old session left running in the worktree has no parent now
    wt = worktree_of(entry.get("cwd"))
    if wt:
        sweep_worktrees([wt])
    # other pm-pane calls may have changed the registry meanwhile: patch only this entry, under the lock (issue 504)
    with update(PANES, []) as reg:
        entry = next((r for r in reg if r["name"] == a.name), entry)
        entry["session"] = new or entry.get("session")
        entry["resets"] = entry.get("resets", 0) + 1
        entry["reset_at"] = now()
        entry.pop("resetting", None)
        if entry not in reg:
            reg.append(entry)
    record_history({**entry, "event": "reset"})
    herdr("agent", "prompt", a.name, brief_text(entry, resumed=True))
    log(f"pane reset {a.name} session {old} -> {new}")
    print(f"reset {a.name}: session {old} -> {new or '(unchanged?)'}")


def cmd_close(a):
    if a.issue:
        guard(f"pm-pane close --issue {a.issue}")
    else:
        asker = guard(f"pm-pane close {a.name}", issue=issue_of(a.name), plan_may=True)
        own_pane(asker, a.name, load(PANES, []))
    reg = registry()
    targets = [r for r in reg if (a.name and r["name"] == a.name) or (a.issue and r["issue"] == str(a.issue))]
    if not targets:
        sys.exit("nothing to close")
    names = {r["name"] for r in targets}
    with contextlib.ExitStack() as marks:
        for n_ in sorted(names):  # marked as being closed, so pm-watchd takes none for a pane the registry lost
            marks.enter_context(pane_op(n_))
        # first, so the daemon never reports a deliberate close as gone; the registry as it is now (issue 504)
        with update(PANES, []) as now_reg:
            now_reg[:] = [r for r in now_reg if r.get("name") not in names]
        for r in targets:
            if not r.get("gone"):
                herdr("pane", "close", r["pane_id"], check=False)
            log(f"pane close {r['name']} {r['pane_id']}")
            print(f"closed {r['name']} {r['pane_id']}", flush=True)
        # herdr lists a closed pane's agent for a moment after the close: the marks stay until it lists none (issue 510)
        settle_close([r for r in targets if not r.get("gone")])
    # a closed pane's processes become orphans over a moment, so the sweep keeps looking for at least 2 s
    wts = []
    for r in targets:
        wt = worktree_of(r.get("cwd"))
        if wt and wt not in wts:
            wts.append(wt)
    sweep_worktrees(wts, settle_min=2)


def settle_close(closed, bound=None):
    """Wait until `herdr agent list` lists no agent in a pane of `closed` (registry entries this call closed), at most
    CLOSE_SETTLE seconds; a failed list ends the wait. Past the bound one log line names each agent herdr still lists."""
    ids = {r["pane_id"]: r["name"] for r in closed}
    if not ids:
        return
    end = time.monotonic() + (CLOSE_SETTLE if bound is None else bound)
    while True:
        r = herdr("agent", "list", check=False)
        if r is None:
            return
        held = {x.get("pane_id") for x in r.get("agents", []) or []} & set(ids)
        if not held:
            return
        if time.monotonic() >= end:
            for pid in sorted(held):
                log(f"pane close {ids[pid]}: herdr still lists its agent after {CLOSE_SETTLE:g} s")
            return
        time.sleep(0.25)


def cmd_list(a):
    reg = registry()
    ags = {x.get("name"): x for x in (herdr("agent", "list", check=False) or {}).get("agents", [])}
    used, su, st = mem_gb()
    print(f"mem used {used:.1f}GB swap {su:.1f}/{st:.1f}GB cpu {cpu_pct()}%; live panes {len(live(reg))}/{LIMITS['total']}")
    for r in reg:
        st_ = "gone" if r.get("gone") else (ags.get(r["name"]) or {}).get("agent_status", "?")
        print(f"  {r['name']:16} {r['pane_id']:8} {st_:8} {r['kind']:6} {str(r.get('model') or ''):18} {str(r.get('effort') or ''):6} resets={r.get('resets', 0)} {r['cwd']}")


p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
sp = p.add_subparsers(dest="cmd", required=True)
n = sp.add_parser("new"); n.add_argument("issue"); n.add_argument("role", choices=PANE_ROLES)
n.add_argument("--unit"); n.add_argument("--kind", choices=KINDS, help="default: the kind the name had, else claude")
n.add_argument("--model", help="default: the model the name had with that kind, else opus for claude")
n.add_argument("--effort", choices=EFFORTS)
n.add_argument("--cwd"); n.add_argument("--brief"); n.add_argument("--text"); n.add_argument("--no-limit", action="store_true")
n.add_argument("--adopt", action="store_true", help="register an exact-name/cwd/kind agent left after a startup trust dialog")
n.set_defaults(f=cmd_new)
rs = sp.add_parser("reset"); rs.add_argument("name")
rs.add_argument("--wait", type=int, default=420, help="seconds to wait for the marker (default 420)")
rs.set_defaults(f=cmd_reset)
c = sp.add_parser("close"); c.add_argument("name", nargs="?"); c.add_argument("--issue"); c.set_defaults(f=cmd_close)
l = sp.add_parser("list"); l.set_defaults(f=cmd_list)
a = p.parse_args()
a.f(a)
