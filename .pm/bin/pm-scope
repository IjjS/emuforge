#!/usr/bin/env -S python3 -I
"""Say which modules a checkout's changes call for, and why. Changes nothing and writes no file.

  pm-scope <checkout> [--json]
  pm-scope <checkout> --push <before> <after> [--json]

The changes are every path that differs between the checkout's commit and its merge base with its target, plus
every uncommitted change, untracked files included; a renamed file counts under both names. The target is the
branch the checkout's work merges into: feat/<id> for a branch <feat|refactor|fix>/<id>-<rest> when that local
branch (the issue branch) exists, main for every other checkout, an issue branch itself included. Each path is
decided by the first rule of _pmscope.RULES it matches (a path no rule knows calls for every module), and the
answer is the union. The first line is `scope: <kind>, <reason>: <modules or "nothing">`, then one line per
called-for module with the rule's sentence, the number of paths and one of them. Kinds:
  diff   the branch has commits of its own against main: what its paths call for
  main   the head is main's commit or an ancestor of it: the product modules (engine, studio, integration);
         the harness guards are left out
  unit   a unit of an issue branch: what its own paths against feat/<id> call for (a unit without a change of
         its own calls for nothing), except integration, which is left to the issue branch: the first line ends
         `; integration left to feat/<id>` and the module is `deferred` in the object, not called
  full   the changes cannot be read (not the top of a git work tree, no branch main or no issue branch, no commit
         shared with the target, git failed or took over 30 s): every module, with what failed, nothing deferred
Services (issue 327). When integration is called for or deferred, a last line says which services' browser checks
the integration step holds, as _pmscope.select decides it from the changed paths and the manifests:
`  services     every service: <why>` or `  services     <names, or "none"> (<n> paths touch a service)`. A service
is a folder under studio/src/providers/aws/area/services/, and a check is a
service's when its manifest row has `service`; the checks of no service are part of every run. A path under one of
the folders of line 1 of the selection, studio/src/providers/aws/area/services/<service>/ and
tests/integration/studio/services/<service>/ (the service's folder of checks: its support, its manifest), gives that service. A path shared by the services (the engine,
shared Studio code, the checks' shared support under tests/integration/studio/support/, .github/, .pm/bin/, a path
no rule knows), a `service` given, taken away or changed in the manifest, or a manifest that cannot be read gives
every service. The manifest is the rows of tests/integration/manifest.jsonl, then those of each
tests/integration/studio/services/<service>/manifest.jsonl, the services in name order (issue 402). The manifest
read for the head is the work tree's, uncommitted changes included; for the base, the merge base's.
Kinds main, full, only (and pm-check's checks) say every service with the kind as the reason. The object always
holds `services`: {all, names: [sorted names], why}.
--json prints the same as the object pm-check records under `scope`, with `target` (main or feat/<id>). pm-check
and pm-merge decide with the same code. Exit 0 for every answer; 2 for a command line it cannot parse or a
checkout that is not a directory.

--push <before> <after> is the selection of a push of main, for the workflow's step `services` (.github/ci
services): the paths that differ between the commit main had before the push and the pushed commit, every commit of
the push, with the pushed commit's manifest and rules. It prints the services line alone, or with --json the object
{services, paths: <number of changed paths>, line: <the services line>}. Every service, with the reason, when either
id is not 40 hexadecimal digits, the commit before is all zeros, is not in the clone or is not an ancestor of the
pushed commit, or git cannot answer. The two values are taken as they come, whatever they look like (an option
included), and held to their form before git sees them. Exit 0 for every answer; 2 when --push is not followed by
two values.
"""
import argparse
import json
import os
import sys

sys.dont_write_bytecode = True  # it writes no file, not even a cache of its helper
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _pmscope import lines, push, scope, services_line


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("checkout"); p.add_argument("--json", action="store_true")
    argv, commits = sys.argv[1:], None
    if "--push" in argv:  # its two values are taken as they come, so that one like an option is still a value
        i = argv.index("--push")
        commits = argv[i + 1:i + 3]
        if len(commits) != 2:
            p.error("--push takes two values: <before> <after>")
        argv = argv[:i] + argv[i + 3:]
    a = p.parse_args(argv)
    if not os.path.isdir(a.checkout):
        print(f"pm-scope: {a.checkout} is not a directory", file=sys.stderr)
        sys.exit(2)
    top = os.path.realpath(os.path.abspath(a.checkout))
    if commits is not None:
        answer = push(top, *commits)
        answer["line"] = services_line(answer["services"])
        print(json.dumps(answer, indent=1) if a.json else answer["line"])
        return
    sc = scope(os.path.abspath(a.checkout))
    print(json.dumps(sc, indent=1) if a.json else "\n".join(lines(sc)))


main()
