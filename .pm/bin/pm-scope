#!/usr/bin/env -S python3 -I
"""Say which modules a checkout's changes call for, and why. Changes nothing and writes no file.

  pm-scope <checkout> [--json]

The changes are every path that differs between the checkout's commit and its merge base with its target, plus
every uncommitted change, untracked files included; a renamed file counts under both names. The target is the
branch the checkout's work merges into: feat/<id> for a branch <feat|refactor|fix>/<id>-<rest> when that local
branch (the issue branch) exists, main for every other checkout, an issue branch itself included. Each path is
decided by the first rule of _pmscope.RULES it matches (a path no rule knows calls for every module), and the
answer is the union. The first line is `scope: <kind>, <reason>: <modules or "nothing">`, then one line per
called-for module with the rule's sentence, the number of paths and one of them. Kinds:
  diff   the branch has commits of its own against main: what its paths call for
  main   the head is main's commit or an ancestor of it: the product modules (engine, studio, integration);
         the harness tests are left out
  unit   a unit of an issue branch: what its own paths against feat/<id> call for (a unit without a change of
         its own calls for nothing), except integration, which is left to the issue branch: the first line ends
         `; integration left to feat/<id>` and the module is `deferred` in the object, not called
  full   the changes cannot be read (not the top of a git work tree, no branch main or no issue branch, no commit
         shared with the target, git failed or took over 30 s): every module, with what failed, nothing deferred
When harness is called for (kinds diff, unit and full) and the checkout holds at least one on-touch test file
(_pmscope.ON_TOUCH), the module lines are followed by `  harness tests left out: <names or "none">`, the on-touch
files that no changed path is a source of, and one line per called-for on-touch file with its entry's sentence,
the number of its changed sources and one of them; or by `  harness tests every file: <why>` (--full, changes
that cannot be read, a change of _pmscope.py or .pm/bin/tests/run, a path no rule knows). A checkout that holds no
on-touch file prints no such line. The object holds the same under `harness_tests`: {all, why, left_out: [names],
called: {name: [why]}, on_touch}, where on_touch is the number of on-touch files the checkout holds; the key is
absent when harness is not called for.
--json prints the same as the object pm-check records under `scope`, with `target` (main or feat/<id>). pm-check
and pm-merge decide with the same code. Exit 0 for every answer; 2 for a command line it cannot parse or a
checkout that is not a directory.
"""
import argparse
import json
import os
import sys

sys.dont_write_bytecode = True  # it writes no file, not even a cache of its helper
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _pmscope import lines, scope


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("checkout"); p.add_argument("--json", action="store_true")
    a = p.parse_args()
    if not os.path.isdir(a.checkout):
        print(f"pm-scope: {a.checkout} is not a directory", file=sys.stderr)
        sys.exit(2)
    sc = scope(os.path.abspath(a.checkout))
    print(json.dumps(sc, indent=1) if a.json else "\n".join(lines(sc)))


main()
