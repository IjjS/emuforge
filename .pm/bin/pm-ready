#!/usr/bin/env -S python3 -I
"""Collect the owner's READY comments from GitHub issues and hand them to the PM. Agent-independent.

  pm-ready poll [--dry-run]     one pass; meant to run from cron or launchd on the owner's machine
  pm-ready list                 the queue: READY signals not yet taken by the PM
  pm-ready take <issue>         the PM marks an issue as started (removes it from the queue)
  pm-ready schedule [--minutes 5] | unschedule     install or remove a launchd job that runs `poll`

A comment counts only when all hold: its body is exactly READY (surrounding whitespace ignored), its author is the
repository owner (author_association OWNER), it is on an open issue that is not a pull request, and it has not been
handled before. Anyone else's READY is ignored and never queued. Nothing in an issue's text is read here.
For each new signal: it is appended to the queue (.pm/run/ready.json) and delivered to a running PM as
`EVENT go github#<n>` through pm-watchd's inbox. When no PM is running, the command in .pm/run/config.json
"pm_launch" (an argv list; "{issue}" is replaced by the number) is started if set; otherwise a desktop notification
is shown and the signal waits in the queue until a PM session reads `pm-ready list` at start.
The repository is read from `git remote get-url origin`. Needs `gh` logged in; reads only, never writes to GitHub.
"""
import argparse
import json
import os
import pathlib
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _pmlib import ROOT, RUN, load, log, notify, now, save, wake_watchd

STATE = RUN / "ready.json"      # {since, handled: [comment ids], queue: [{issue, comment, at}]}
INBOX = RUN / "inbox.jsonl"
CONFIG = RUN / "config.json"
LABEL = "dev.emuforge.pm-ready"
PLIST = pathlib.Path.home() / "Library" / "LaunchAgents" / f"{LABEL}.plist"


def repo():
    url = subprocess.run(["git", "-C", str(ROOT), "remote", "get-url", "origin"], capture_output=True, text=True).stdout.strip()
    m = re.search(r"github\.com[:/]([\w.-]+)/([\w.-]+?)(?:\.git)?$", url)
    if not m:
        sys.exit(f"origin is not a GitHub repository: {url!r}")
    return f"{m.group(1)}/{m.group(2)}"


def gh_json(path):
    r = subprocess.run(["gh", "api", "--paginate", "--slurp", path], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"gh api {path} failed: {r.stderr.strip()[:300]}")
    pages = json.loads(r.stdout or "[]")
    return [x for page in pages for x in (page if isinstance(page, list) else [page])]


def pm_alive():
    try:
        os.kill(int((RUN / "watchd.pid").read_text()), 0)
        return True
    except (FileNotFoundError, ValueError, ProcessLookupError, PermissionError):
        return False


def cmd_poll(a):
    st = load(STATE, {"since": None, "handled": [], "queue": []})
    name = repo()
    path = f"repos/{name}/issues/comments?per_page=100&sort=updated&direction=asc" + (f"&since={st['since']}" if st.get("since") else "")
    comments = gh_json(path)
    started = now()
    new = []
    for c in comments:
        if c["id"] in st["handled"] or (c.get("body") or "").strip() != "READY" or c.get("author_association") != "OWNER":
            continue
        number = int(c["issue_url"].rsplit("/", 1)[1])
        issue = gh_json(f"repos/{name}/issues/{number}")[0]
        st["handled"].append(c["id"])
        if issue.get("pull_request") or issue.get("state") != "open":
            continue
        if any(q["issue"] == number for q in st["queue"]):
            continue
        new.append(dict(issue=number, comment=c["id"], at=c["created_at"]))
    if a.dry_run:
        print(f"{name}: {len(comments)} comment(s) since {st.get('since')}; new READY: {[n['issue'] for n in new] or 'none'}")
        return
    st["queue"].extend(new)
    st["since"] = max([c["updated_at"] for c in comments], default=st.get("since")) or started
    st["handled"] = st["handled"][-2000:]
    save(STATE, st)
    for n in new:
        line = f"EVENT go github#{n['issue']}"
        log(f"ready {name}#{n['issue']} comment={n['comment']}")
        if pm_alive():
            with INBOX.open("a") as f:
                f.write(json.dumps(dict(ts=now(), line=line)) + "\n")
            wake_watchd()
            continue
        launch = load(CONFIG, {}).get("pm_launch")
        if launch:
            argv = [str(x).replace("{issue}", str(n["issue"])) for x in launch]
            subprocess.Popen(argv, cwd=str(ROOT), stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            log(f"ready launch {argv[0]} for #{n['issue']}")
        else:
            notify("EmuForge", f"READY on #{n['issue']}: no PM session is running; it waits in the queue")
    print(f"{name}: new READY {[n['issue'] for n in new] or 'none'}; queue {[q['issue'] for q in st['queue']] or 'empty'}")


def cmd_list(a):
    for q in load(STATE, {}).get("queue", []):
        print(f"github#{q['issue']} READY at {q['at']}")


def cmd_take(a):
    st = load(STATE, {"queue": []})
    before = len(st["queue"])
    st["queue"] = [q for q in st["queue"] if q["issue"] != a.issue]
    save(STATE, st)
    print(f"taken github#{a.issue}" if len(st["queue"]) < before else f"github#{a.issue} was not in the queue")


def cmd_schedule(a):
    plist = f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>{LABEL}</string>
<key>ProgramArguments</key><array><string>{os.path.abspath(__file__)}</string><string>poll</string></array>
<key>StartInterval</key><integer>{a.minutes * 60}</integer>
<key>EnvironmentVariables</key><dict><key>PATH</key><string>{os.environ.get("PATH", "/usr/bin:/bin")}</string></dict>
<key>StandardOutPath</key><string>{RUN / "ready.log"}</string>
<key>StandardErrorPath</key><string>{RUN / "ready.log"}</string>
</dict></plist>
"""
    PLIST.parent.mkdir(parents=True, exist_ok=True)
    PLIST.write_text(plist)
    uid = os.getuid()
    subprocess.run(["launchctl", "bootout", f"gui/{uid}/{LABEL}"], capture_output=True)
    r = subprocess.run(["launchctl", "bootstrap", f"gui/{uid}", str(PLIST)], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit(f"launchctl bootstrap failed: {r.stderr.strip()}")
    print(f"scheduled: poll every {a.minutes} min ({PLIST}); log {RUN / 'ready.log'}")


def cmd_unschedule(a):
    subprocess.run(["launchctl", "bootout", f"gui/{os.getuid()}/{LABEL}"], capture_output=True)
    PLIST.unlink(missing_ok=True)
    print("unscheduled")


p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
sp = p.add_subparsers(dest="cmd", required=True)
x = sp.add_parser("poll"); x.add_argument("--dry-run", action="store_true"); x.set_defaults(f=cmd_poll)
x = sp.add_parser("list"); x.set_defaults(f=cmd_list)
x = sp.add_parser("take"); x.add_argument("issue", type=int); x.set_defaults(f=cmd_take)
x = sp.add_parser("schedule"); x.add_argument("--minutes", type=int, default=5); x.set_defaults(f=cmd_schedule)
x = sp.add_parser("unschedule"); x.set_defaults(f=cmd_unschedule)
a = p.parse_args()
a.f(a)
