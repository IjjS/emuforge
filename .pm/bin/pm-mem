#!/usr/bin/env -S python3 -I
"""Memory, swap and thermal state of the machine. CPU is informational.

  pm-mem                      -> "used 14.4GB swap 6.8/8.0GB thermal fair cpu 43%"
  pm-mem --check [GB]          exit 1 when used > GB (default 22.5), swap free < 256 MB, or thermal state is serious or critical
  pm-mem --wait [SECONDS]      like --check, but waits up to SECONDS (default 300) for thermal state to clear.
                              Memory and swap fail at once, including during the wait.
  pm-mem --json

Memory is active + wired + compressed pages. CPU is what all cores used over one second (100 - idle).
Run --check (or --wait) before cargo build, Playwright, a dev server or an emulator. pm-check has its own admission.
"""
import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _pmlib import LIMITS, cpu_pct, mem_gb, memory_room, thermal_room, thermal_state


def main():
    args = sys.argv[1:]
    mode = args[0] if args else ""
    if mode in ("-h", "--help"):
        print(__doc__)
        return 0
    cpu = cpu_pct()
    limit = float(args[1]) if mode == "--check" and len(args) > 1 else LIMITS["mem_gb"]
    deadline = time.monotonic() + (float(args[1]) if mode == "--wait" and len(args) > 1 else 300)
    while True:
        mem, thermal = mem_gb(), thermal_state()
        memory_limit = memory_room(mem, limit)
        heat_limit = thermal_room(thermal)
        if mode != "--wait" or memory_limit or not heat_limit or time.monotonic() >= deadline:
            break
        time.sleep(min(10, max(0, deadline - time.monotonic())))
    used, su, st = mem
    if mode == "--json":
        print(json.dumps(dict(used_gb=round(used, 1), swap_used_gb=round(su, 1), swap_total_gb=round(st, 1),
                              swap_free_mb=round((st - su) * 1024), thermal_state=thermal, cpu_pct=cpu)))
        return 0
    cpu_display = f"{cpu:.0f}%" if cpu is not None else "?"
    print(f"used {used:.1f}GB swap {su:.1f}/{st:.1f}GB thermal {thermal or '?'} cpu {cpu_display}")
    why = memory_limit or heat_limit
    if mode in ("--check", "--wait") and why:
        print("OVER limit: " + why)
        return 1
    return 0


sys.exit(main())
