#!/bin/sh
# The stand-in that test_hang.py runs instead of pm-structure (issue 37). It ignores its arguments.
#
# By default it ignores SIGTERM, SIGHUP and SIGINT, starts one child (/bin/sleep 120, its streams on /dev/null so
# that a pipe to the test is held by the stand-in alone) and waits for it: both end by themselves after 120 s.
# HANG_STANDIN_ENDS=1: it exits 2 at the first of those signals, after killing its child.
# HANG_STANDIN_ENDS=at-once: it exits 0 as soon as it starts, with no child.
case "$HANG_STANDIN_ENDS" in
    at-once)
        exit 0
        ;;
    1)
        trap 'kill "$child" 2>/dev/null; exit 2' TERM HUP INT
        ;;
    *)
        trap '' TERM HUP INT
        ;;
esac
/bin/sleep 120 </dev/null >/dev/null 2>&1 &
child=$!
while kill -0 "$child" 2>/dev/null; do
    wait "$child"
done
