#!/usr/bin/env -S python3 -I
"""Run the harness guards: unittest discovery of test_*.py in this directory, verbosity 2.

  .pm/bin/tests/run

pm-check's harness step runs it from .pm/bin/tests. .pm/bin is put on sys.path so a test imports the module it
guards. Exit code 0 only when every test passed; 1 on any failure or error, or when no test was found; 2, with the
usage line on stderr, for any argument.

The harness keeps no tests but the guards of what a script may delete, stop or remove (issue 523, test_guards.py);
together they run in under 30 s.
"""
import os
import sys
import unittest

HERE = os.path.dirname(os.path.abspath(__file__))

if sys.argv[1:]:
    print("usage: .pm/bin/tests/run", file=sys.stderr)
    sys.exit(2)
sys.path.insert(0, os.path.dirname(HERE))
suite = unittest.defaultTestLoader.discover(HERE, pattern="test_*.py", top_level_dir=HERE)
result = unittest.TextTestRunner(stream=sys.stdout, verbosity=2).run(suite)
if not result.testsRun:
    print("no test_*.py test found in", HERE)
sys.exit(0 if result.wasSuccessful() and result.testsRun else 1)
