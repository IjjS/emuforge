#!/usr/bin/env -S python3 -I
"""Create and remove sibling worktrees for worker panes.

  pm-worktree new <issue>
  pm-worktree new <issue> <unit> [--type feat|refactor|fix] [--branch NAME] [--base BRANCH]
  pm-worktree rm <path|name> [--keep-branch | --delete-branch]
  pm-worktree list

new <issue> (no unit) makes the issue branch: the branch feat/<issue> from local main and its worktree
<parent of the main checkout>/emuforge-<issue>, registered with unit "issue" and base main. It refuses, and makes
nothing, when <issue> is not digits, when --base, --branch or --type is given (an issue branch is always
feat/<issue> from main), when any worktree of the issue is registered (an issue in flight finishes without an
issue branch), or when a branch feat/<issue> exists that is not registered (it is never reopened). A worktree add
that does not finish in 120 s is undone and nothing is registered.
new <issue> <unit>: path <parent of the main checkout>/emuforge-<issue>-<unit>, a sibling of the main checkout,
never inside it. The base is the issue branch feat/<issue> when it is registered, else local main; --base gives a
parent unit's branch for a stacked unit. Nothing is fetched, because local main is the line the PM maintains. The
unit "issue" and a branch <feat|refactor|fix>/<digits> (the name of an issue branch) are refused; while the issue
has an issue branch, so is a --branch that is not <feat|refactor|fix>/<issue>-<name>, so every unit of the issue
has a branch whose target is the issue branch. Every worktree gets output/{captures,logs} and three ports in output/ports.json:
studio (8100+), engine (8300+) and emulator (9300+), so parallel units never share a server or an emulator.
When studio/package.json exists, `bun install` runs there (log in output/logs/install.log).
Who may run it: the pm, and a plan for its own issue: `new <its issue>`, `new <its issue> <e<n>|s<n>>` once the issue
branch is registered (based on it, or with --base on a unit branch <type>/<issue>-<name> of the issue), and `rm` of a
unit worktree of its issue (the issue's own worktree goes with pm-archive). Every other pane is refused all but `list`.
rm removes the worktree, frees its ports and deletes the branch only when it is merged into local main. Before
that it runs `pm-emulator-dir rm --worktree` for the worktree, merged or not, and prints its line: the folder the
worktree's emulator port left under ~/.aws/emulator. A refusal there does not stop the removal.
"""
import argparse
import json
import os
import re
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _pmlib import BIN, PORTS, ROOT, WORKTREES, guard, load, log, now, save
from _pmscope import Unreadable, run_git

BRANCH_TYPES = ("feat", "refactor", "fix")
ISSUE = "issue"  # the registry's unit of an issue branch; no unit can be called so
ISSUE_BRANCH = re.compile(r"(feat|refactor|fix)/\d+")  # the name of an issue branch, matched whole
ADD_TIMEOUT = 120  # seconds the issue branch's `git worktree add` may take
PORT_BASES = {"studio": 8100, "engine": 8300, "emulator": 9300}
EMULATOR_DIR = "pm-emulator-dir: "


def run(cmd, cwd=None, out=None):
    print("$", " ".join(cmd))
    if out:
        with open(out, "a") as f:
            return subprocess.run(cmd, cwd=cwd, stdout=f, stderr=subprocess.STDOUT).returncode
    return subprocess.run(cmd, cwd=cwd).returncode


def alloc_slot(path):
    """One slot number per worktree; each port is its base plus the slot."""
    slots = load(PORTS, {})
    for slot in range(0, 100):
        if str(slot) not in slots:
            slots[str(slot)] = str(path)
            save(PORTS, slots)
            return slot
    sys.exit("no free port slot (100 worktrees registered?)")


def issue_entry(wts, issue):
    """The registry entry of the issue's branch, or None."""
    return next((w for w in wts if w.get("issue") == str(issue) and w.get("unit") == ISSUE), None)


def plan_may_make(a):
    """A plan makes its issue's branch, and engine or studio units cut from it (or stacked on one of its units)."""
    asker = guard(f"pm-worktree new {a.issue}", issue=a.issue, plan_may=True)
    if not asker or a.unit is None:
        return
    if not re.fullmatch(r"[es]\d+", a.unit):
        sys.exit(f"refused: a plan's units are e<n> (engine) or s<n> (studio); not {a.unit}")
    if issue_entry(load(WORKTREES, []), a.issue) is None:
        sys.exit(f"refused: make the issue branch first (pm-worktree new {a.issue}); a plan's units are cut from it")
    if a.base and not re.fullmatch(rf"(feat|refactor|fix)/{re.escape(str(a.issue))}(-.+)?", a.base):
        sys.exit(f"refused: a plan's unit is based on feat/{a.issue} or on a unit branch of #{a.issue}; not {a.base}")


def cmd_new(a):
    plan_may_make(a)
    if a.unit is None:
        return cmd_new_issue(a)
    if a.unit == ISSUE:
        sys.exit(f"{ISSUE} is the name of an issue branch, not of a unit; the issue branch is made with "
                 f"pm-worktree new {a.issue}")
    name = f"{ROOT.name}-{a.issue}-{a.unit}"
    path = ROOT.parent / name
    if path.exists():
        sys.exit(f"{path} exists")
    branch = a.branch or f"{a.type or 'feat'}/{a.issue}-{a.unit}"
    head, _, tail = branch.partition("/")
    if head not in BRANCH_TYPES or not tail:
        sys.exit(f"branch {branch} must be <feat|refactor|fix>/<name>")
    if ISSUE_BRANCH.fullmatch(branch):
        sys.exit(f"{branch} is the name of an issue branch")
    has_issue_branch = issue_entry(load(WORKTREES, []), a.issue) is not None
    if has_issue_branch and not re.fullmatch(rf"(feat|refactor|fix)/{re.escape(str(a.issue))}-.+", branch):
        sys.exit(f"branch {branch} must be <feat|refactor|fix>/{a.issue}-<name>: issue {a.issue} has an issue branch")
    base = a.base or (f"feat/{a.issue}" if has_issue_branch else "main")
    if subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--verify", "--quiet", base], capture_output=True).returncode != 0:
        sys.exit(f"base {base} does not exist; the repository needs at least one commit on main")
    exists = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}"], capture_output=True).returncode == 0
    add = ["git", "-C", str(ROOT), "worktree", "add", str(path), branch] if exists else ["git", "-C", str(ROOT), "worktree", "add", "-b", branch, str(path), base]
    if exists:
        print(f"branch {branch} exists; reopening it (post-processing)")
    if run(add) != 0:
        sys.exit("worktree add failed")
    register(path, name, a.issue, a.unit, branch, base)


def cmd_new_issue(a):
    """The issue branch feat/<issue> from main and its worktree, registered with unit "issue" (R1.1, R1.2)."""
    issue = str(a.issue)
    if not issue.isdigit():
        sys.exit(f"issue {issue} is not a number; an issue branch is feat/<digits>")
    if a.base or a.branch or a.type:
        sys.exit(f"an issue branch is always feat/{issue} from main; drop --base, --branch and --type")
    mine = [w["name"] for w in load(WORKTREES, []) if w.get("issue") == issue]
    if mine:
        sys.exit(f"issue {issue} already has worktrees ({', '.join(mine)}); an issue in flight finishes without an "
                 f"issue branch")
    branch, name = f"feat/{issue}", f"{ROOT.name}-{issue}"
    path = ROOT.parent / name
    try:
        known = run_git(ROOT, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}^{{commit}}").returncode == 0
        main = run_git(ROOT, "rev-parse", "--verify", "--quiet", "refs/heads/main^{commit}")
    except Unreadable as e:
        sys.exit(f"cannot read the branches: {e}")
    if known:
        sys.exit(f"branch {branch} exists and is not registered as the issue's branch")
    if main.returncode != 0:
        sys.exit("main does not exist; the repository needs at least one commit on main")
    if path.exists():
        sys.exit(f"{path} exists")
    start = main.stdout.strip()
    add = ["git", "-C", str(ROOT), "worktree", "add", "-b", branch, str(path), start]
    print("$", " ".join(add))
    try:
        code = subprocess.run(add, stdin=subprocess.DEVNULL, timeout=ADD_TIMEOUT).returncode
    except subprocess.TimeoutExpired:
        sys.exit(f"worktree add did not finish in {ADD_TIMEOUT} s; {undo_add(path, branch, start)}")
    if code != 0:
        sys.exit("worktree add failed")
    register(path, name, issue, ISSUE, branch, "main")


def undo_add(path, branch, start):
    """Take back what an unfinished `worktree add` left; say what was left behind. Nothing is registered."""
    left = []
    for args in (("worktree", "remove", "--force", str(path)), ("worktree", "prune")):
        try:
            run_git(ROOT, *args)
        except Unreadable:
            left.append(f"git {' '.join(args[:2])} did not answer")
    try:
        at = run_git(ROOT, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}^{{commit}}")
        if at.returncode == 0 and at.stdout.strip() == start:
            if run_git(ROOT, "branch", "-D", branch).returncode != 0:
                left.append(f"branch {branch} left behind (it could not be deleted)")
        elif at.returncode == 0:
            left.append(f"branch {branch} left behind (it is not at {start[:9]})")
    except Unreadable as e:
        left.append(f"branch {branch} may be left behind ({e})")
    if path.exists():
        left.append(f"{path} left behind")
    return "nothing registered" + (": " + "; ".join(left) if left else "")


def register(path, name, issue, unit, branch, base):
    """What every new worktree gets after `worktree add`: folders, ports, Studio's install, its registry entry."""
    for d in ("output/captures", "output/logs"):
        (path / d).mkdir(parents=True, exist_ok=True)
    slot = alloc_slot(path)
    ports = {k: base + slot for k, base in PORT_BASES.items()}
    (path / "output" / "ports.json").write_text(json.dumps(ports))
    if (path / "studio" / "package.json").exists():
        print("bun install in studio (log: output/logs/install.log) ...")
        if run(["bun", "install"], cwd=str(path / "studio"), out=str(path / "output/logs/install.log")) != 0:
            print("WARN bun install failed; see output/logs/install.log")
    wts = load(WORKTREES, [])
    wts.append(dict(name=name, path=str(path), issue=str(issue), unit=unit, branch=branch, base=base, slot=slot, ports=ports, created=now()))
    save(WORKTREES, wts)
    log(f"worktree new {name} {branch} slot={slot}")
    print(f"{path} branch={branch} base={base} ports={ports}")


def remove_emulator_dir(wt):
    """Run pm-emulator-dir for the worktree and pass on its lines; nothing it does stops the removal."""
    try:
        r = subprocess.run([str(BIN / "pm-emulator-dir"), "rm", "--worktree", wt["path"]], capture_output=True,
                           text=True, timeout=60)
    except subprocess.TimeoutExpired:
        print(f"{EMULATOR_DIR}did not run for {wt['name']}: timeout after 60 s")
        return
    except OSError as e:
        print(f"{EMULATOR_DIR}did not run for {wt['name']}: {type(e).__name__}")
        return
    lines = [ln for ln in r.stdout.splitlines() if ln.startswith(EMULATOR_DIR)]
    print("\n".join(lines) if lines else f"{EMULATOR_DIR}no line for {wt['name']} (exit {r.returncode})")


def cmd_rm(a):
    wts = load(WORKTREES, [])
    key = os.path.basename(os.path.abspath(a.target)) if "/" in a.target else a.target
    wt = next((w for w in wts if w["name"] == key), None)
    asker = guard(f"pm-worktree rm {key}", issue=(wt or {}).get("issue"), plan_may=True)
    if not wt:
        sys.exit(f"{key} not in registry; remove it by hand with git worktree remove")
    if asker and wt.get("unit") == ISSUE:
        sys.exit(f"refused: the issue's own worktree {key} is removed by pm-archive, the pm's")
    remove_emulator_dir(wt)
    run(["git", "-C", str(ROOT), "worktree", "remove", "--force", wt["path"]])
    run(["git", "-C", str(ROOT), "worktree", "prune"])
    merged = subprocess.run(["git", "-C", str(ROOT), "merge-base", "--is-ancestor", wt["branch"], "main"], capture_output=True).returncode == 0
    if a.delete_branch or (merged and not a.keep_branch):
        run(["git", "-C", str(ROOT), "branch", "-D", wt["branch"]])
    elif not merged:
        print(f"branch {wt['branch']} is not merged into main; kept")
    slots = load(PORTS, {})
    slots.pop(str(wt.get("slot")), None)
    save(PORTS, slots)
    save(WORKTREES, [w for w in wts if w is not wt])
    log(f"worktree rm {wt['name']}")
    print(f"removed {wt['path']}")


def cmd_list(a):
    for w in load(WORKTREES, []):
        print(f"  {w['name']:24} {w['branch']:24} ports={w.get('ports')} {'ok' if os.path.isdir(w['path']) else 'MISSING'}")


p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
sp = p.add_subparsers(dest="cmd", required=True)
n = sp.add_parser("new"); n.add_argument("issue"); n.add_argument("unit", nargs="?")
n.add_argument("--type", choices=BRANCH_TYPES, help="default feat"); n.add_argument("--branch")
n.add_argument("--base", help="default: the issue branch when it is registered, else main")
n.set_defaults(f=cmd_new)
r = sp.add_parser("rm"); r.add_argument("target"); r.add_argument("--keep-branch", action="store_true")
r.add_argument("--delete-branch", action="store_true", help="delete the local branch even when it is not merged"); r.set_defaults(f=cmd_rm)
l = sp.add_parser("list"); l.set_defaults(f=cmd_list)
a = p.parse_args()
a.f(a)
