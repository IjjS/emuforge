#!/usr/bin/env -S python3 -I
"""Fill a brief template for a pane and write it to .pm/issue-<id>/. The PM runs this instead of filling `{{…}}` by hand.

  pm-brief plan <issue> [--precedent <archived id>]...
        writes brief-plan.md and brief-rev.md (one rev pane serves the whole issue)
        and marks the issue `lead: plan` in brief.json (pm-merge reads it)
  pm-brief worker <issue> <unit> --summary "<what the unit does>" [--owned "<files>"] [--scenarios "<where>"]
        [--close "<check ids>" | --close auto] [--precedent <id>]... [--inputs "<a, b>"] [--conventions "<a, b>"]
        writes brief-<unit>.md, for an engine (e<n>) or studio (s<n>) unit. --owned defaults to "the files
        breakdown.md lists for `<unit>`"; --scenarios, the unit-test scenarios that are the unit's end condition,
        defaults to "the unit-test scenarios test-criteria.md lists for `<unit>`"; --close names the check ids for
        the unit that closes the issue (auto: "the ids breakdown.md and test-criteria.md give")
  pm-brief harness-engineer <issue> <unit> --part "<what this pane plans and builds>" [--not-last] [--precedent <id>]...
        writes brief-harness-engineer.md for the unit's worktree and marks the issue `lead: harness-engineer`. The
        part closes the issue (its close step runs pm-issue close on the unit's branch before pm-check) unless
        --not-last says another part follows; brief.json records `parts: {<unit>: "last"|"not-last"}`, which
        pm-merge reads: it refuses a `last` part while the issue's file is open on its branch (issue 504)
  pm-brief crit <issue> --targets "<routes or mock files>" --capture-wt <worktree>
        writes brief-crit.md
  pm-brief show <issue>
        the briefs written so far and the values remembered for the issue

Templates: .agents/skills/pm/references/briefs/{plan,rev,worker,crit,harness-engineer}.md; what each placeholder means:
briefs/README.md. Everything that can be looked up is looked up:
  issue, title, module, kind, issue file   from the issue file (open or closed)
  worktree, branch, base                   from the worktree registry (run pm-worktree new first)
  references to read                       from the module (its AGENTS.md and every file in its references/)
  inputs, conventions                      from the unit's side (its first letter: e, s)
Who may run it: the pm, and a plan for its own issue (`worker`, `crit`, `show`); `plan` and `harness-engineer` are
the pm's. Every other pane is refused all but `show`.
A studio issue has no screen grade (issue 478 removed it with the structure score): its design stage is `design.md`
and its crit brief is written when the plan has a screen to critique. The command fails, and writes nothing, when a placeholder is left unfilled or a value it needs is
missing. Pass the written file to `pm-pane new … --brief <file>`.
"""
import argparse
import os
import pathlib
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _pmlib import PM, ROOT, WORKTREES, guard, issue_dir, load, save

BRIEFS = ROOT / ".agents" / "skills" / "pm" / "references" / "briefs"
ISSUE_DIRS = ("issues/things-that-do-not-work", "issues/things-that-now-work")
# the folder whose AGENTS.md and references/ an issue of this module is planned and reviewed against
MODULE_DIR = {"studio": "studio", "engine": "engine", "cli": "engine", "iam": "engine", "verify": "engine", "harness": "engine"}
DESIGN_STEP = {
    "engine": "`design.md` per engine/references/workflow.md stage 2, with the security review rows for everything the "
              "change touches. Written with `test-criteria.md` and `breakdown.md` and sent with them as one set: "
              "REVIEW plan-set r1.",
    "studio": "`design.md` per studio/references/workflow.md stage 2: per task, its flow through the screens and the API "
              "call behind each action, the console captures read for its UX, and what is shared. Written with "
              "`test-criteria.md` and `breakdown.md` and sent with them as one set: REVIEW plan-set r1.",
}
CONVENTIONS = {
    "e": "`engine/AGENTS.md`, `engine/references/security-review.md`, `engine/references/relay-fidelity.md`",
    "s": "`studio/AGENTS.md`",
}


def issue(n):
    """Header values, title and path of the issue file with this Issue-Id."""
    for d in ISSUE_DIRS:
        for f in sorted((ROOT / d).glob("*.md")):
            text = f.read_text(errors="replace")
            if re.search(rf"(?m)^Issue-Id:\s*{re.escape(str(n))}\s*$", text):
                head = dict(re.findall(r"(?m)^Issue-([A-Za-z-]+):[ \t]*(.*)$", text))
                title = re.search(r"(?m)^# (.+)$", text)
                if not title or head.get("Module") not in MODULE_DIR:
                    sys.exit(f"{f}: no title or no known Issue-Module")
                return dict(issue=str(n), title=title.group(1).strip(), module=head["Module"].strip(),
                            kind=head.get("Kind", "").strip(), issue_file=str(f.relative_to(ROOT)))
    sys.exit(f"no issue file with Issue-Id {n} under issues/")


def module_refs(module):
    d = MODULE_DIR[module]
    refs = sorted(str(p.relative_to(ROOT)) for p in (ROOT / d / "references").glob("*") if p.is_file())
    return ", ".join([f"{d}/AGENTS.md", *refs])


def precedents(ids):
    for m in ids:
        if not (PM / "archive" / f"{m}.md").exists():
            sys.exit(f"no archive .pm/archive/{m}.md for --precedent {m}")
    return "".join(f", .pm/archive/{m}.md (precedent)" for m in ids)


def fill(template, values):
    text = template
    for _ in range(5):  # a value may itself hold placeholders (work holds close_step, which holds root)
        before = text
        for k, v in values.items():
            text = text.replace("{{%s}}" % k, v)
        if text == before:
            break
    left = sorted(set(re.findall(r"\{\{.*?\}\}", text)))
    if left:
        sys.exit(f"unfilled placeholders: {', '.join(left)}")
    return text


def write(n, name, text):
    path = issue_dir(n) / f"brief-{name}.md"
    path.write_text(text)
    print(path)


def mark_lead(n, who):
    """Who leads the issue: `plan` or `harness-engineer`, for pm-merge's review rule."""
    memo = load(issue_dir(n) / "brief.json", {})
    if memo.get("lead") != who:
        save(issue_dir(n) / "brief.json", {**memo, "lead": who})


def cmd_plan(a):
    guard(f"pm-brief plan {a.issue}")
    v = issue(a.issue)
    refs = module_refs(v["module"])
    common = dict(v, root=str(ROOT))
    plan = dict(common, precedents=precedents(a.precedent), design_step=DESIGN_STEP["studio" if v["module"] == "studio" else "engine"],
                plan_refs=f"AGENTS.md, issues/README.md, tests/integration/AGENTS.md, {refs}")
    rev = dict(common, refs=f"AGENTS.md, issues/README.md, {refs}, tests/integration/AGENTS.md")
    texts = [("plan", fill((BRIEFS / "plan.md").read_text(), plan)), ("rev", fill((BRIEFS / "rev.md").read_text(), rev))]
    for name, text in texts:  # both filled before either is written
        write(a.issue, name, text)
    mark_lead(a.issue, "plan")


def cmd_worker(a):
    guard(f"pm-brief worker {a.issue} {a.unit}", issue=a.issue, plan_may=True)
    v = issue(a.issue)
    side = a.unit[:1]
    if not re.fullmatch(r"[es]\d+", a.unit):
        sys.exit(f"unit {a.unit!r}: expected e<n> (engine) or s<n> (studio); a harness issue goes to pm-brief harness-engineer")
    wt = next((w for w in load(WORKTREES, []) if w["issue"] == str(a.issue) and w["unit"] == a.unit), None)
    if not wt:
        sys.exit(f"no registered worktree for issue {a.issue} unit {a.unit}; run pm-worktree new first")
    inputs = a.inputs or "`requirement.md`, `decisions.md`, `design.md`, `test-criteria.md`"
    ids = "<the check ids breakdown.md and test-criteria.md give this issue>" if a.close == "auto" else a.close
    close = (f'Run {{{{root}}}}/.pm/bin/pm-issue close {{{{issue}}}} --checks "{ids}" --in {{{{worktree}}}} and commit the '
             "move with your last commit.") if a.close else "(This unit does not close the issue; nothing to do in this step.)"
    values = dict(v, root=str(ROOT), unit=a.unit, unit_summary=a.summary.strip(), owned_files=(a.owned or f"the files breakdown.md lists for `{a.unit}`").strip(),
                  scenarios=(a.scenarios or f"the unit-test scenarios `test-criteria.md` lists for `{a.unit}`").strip(),
                  worktree=wt["path"], branch=wt["branch"], base=wt.get("base") or "main", inputs=inputs,
                  conventions=a.conventions or CONVENTIONS[side], precedents=precedents(a.precedent), close_step=close)
    write(a.issue, a.unit, fill((BRIEFS / "worker.md").read_text(), values))


def cmd_harness(a):
    guard(f"pm-brief harness-engineer {a.issue}")
    v = issue(a.issue)
    wt = next((w for w in load(WORKTREES, []) if w["issue"] == str(a.issue) and w["unit"] == a.unit), None)
    if not wt:
        sys.exit(f"no registered worktree for issue {a.issue} unit {a.unit}; run pm-worktree new {a.issue} {a.unit} first")
    if a.not_last:
        close = ("(This part does not close the issue: another part follows. Leave its file under "
                 "issues/things-that-do-not-work/.)")
    else:
        close = ('Close the issue on your branch: {{root}}/.pm/bin/pm-issue close {{issue}} --checks "<the harness check '
                 'ids of the tests that show the fix, harness.<test file name without test_ and .py, - for _>>" '
                 "--in {{worktree}}, and commit the move with your last commit, before pm-check. pm-merge refuses "
                 "this part while the issue's file is still under issues/things-that-do-not-work/ on your branch.")
    values = dict(v, root=str(ROOT), unit=a.unit, part=a.part.strip(), worktree=wt["path"], branch=wt["branch"],
                  base=wt.get("base") or "main", precedents=precedents(a.precedent), close_step=close)
    write(a.issue, "harness-engineer", fill((BRIEFS / "harness-engineer.md").read_text(), values))
    mark_lead(a.issue, "harness-engineer")
    memo = load(issue_dir(a.issue) / "brief.json", {})
    parts = {**(memo.get("parts") or {}), a.unit: "not-last" if a.not_last else "last"}
    save(issue_dir(a.issue) / "brief.json", {**memo, "parts": parts})


def cmd_crit(a):
    guard(f"pm-brief crit {a.issue}", issue=a.issue, plan_may=True)
    v = issue(a.issue)
    if v["module"] != "studio":
        sys.exit(f"#{a.issue} has no screen to score (module {v['module']})")
    wt = pathlib.Path(a.capture_wt).resolve()
    if not (wt / "studio").is_dir():
        sys.exit(f"{wt} has no studio/ folder")
    values = dict(v, root=str(ROOT), targets=a.targets.strip(), capture_wt=str(wt))
    write(a.issue, "crit", fill((BRIEFS / "crit.md").read_text(), values))


def cmd_show(a):
    d = PM / f"issue-{a.issue}"
    print(f"remembered: {load(d / 'brief.json', {})}")
    for f in sorted(d.glob("brief-*.md")):
        print(f)


p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
sp = p.add_subparsers(dest="cmd", required=True)
x = sp.add_parser("plan"); x.add_argument("issue")
x.add_argument("--precedent", action="append", default=[]); x.set_defaults(f=cmd_plan)
x = sp.add_parser("worker"); x.add_argument("issue"); x.add_argument("unit")
x.add_argument("--summary", required=True); x.add_argument("--owned"); x.add_argument("--close"); x.add_argument("--scenarios")
x.add_argument("--precedent", action="append", default=[]); x.add_argument("--inputs"); x.add_argument("--conventions")
x.set_defaults(f=cmd_worker)
x = sp.add_parser("harness-engineer"); x.add_argument("issue"); x.add_argument("unit"); x.add_argument("--part", required=True)
x.add_argument("--not-last", action="store_true", help="another part of the issue follows; this one does not close it")
x.add_argument("--precedent", action="append", default=[]); x.set_defaults(f=cmd_harness)
x = sp.add_parser("crit"); x.add_argument("issue"); x.add_argument("--targets", required=True)
x.add_argument("--capture-wt", required=True); x.set_defaults(f=cmd_crit)
x = sp.add_parser("show"); x.add_argument("issue"); x.set_defaults(f=cmd_show)
a = p.parse_args()
a.f(a)
