#!/usr/bin/env -S python3 -I
"""Score a console screen against its reference spec (studio/references/console-reference.md, "Structure score").

  pm-structure <worktree> <spec.yaml> (--url BASE | --serve DIR [--port N] | --snapshot FILE)
               [--state seeded|empty] [--storage-state FILE] [--record ISSUE POINT]
  pm-structure --table ISSUE

--url BASE opens BASE + the spec's route; BASE must be a loopback IP address (127.0.0.0/8 or [::1]; `localhost`
and every other name are refused). --serve DIR serves the built app in DIR on 127.0.0.1 with the single-page
fallback, on --port, else the studio port of <worktree>/output/ports.json, else the first free port from 8090, and
stops it before exiting. The page is opened in headless Chromium from @playwright/test in <worktree>/studio
(1280x800, light), every request to a host that is not loopback is aborted and listed, and the accessibility tree
is taken every 250 ms until two in a row are equal (10 s bound). --storage-state FILE gives the browser context a
Playwright storage state; only the browser reads it. --snapshot scores an accessibility snapshot pm-structure
saved earlier; no browser is started. --state is the data state of the emulator behind the app (default seeded):
table.empty.* apply only to `empty`, a single or multi table.selection only to `seeded`. A spec that has either
needs both runs; each run says `requires also: state=…`.

Prints the score, the unmatched, matched, omitted, not-applicable, not-scored and extra items, the blocked
requests, and the verdict. Exit 0 pass (score >= 90 and no critical item unmatched: header.title,
header.primary_action, table.columns), 1 fail, 2 error (usage, invalid spec, refused URL, page not reachable or not
settled, toolchain missing, unreadable snapshot, another run of the same screen and state in progress, terminated by
SIGTERM, SIGHUP or SIGINT); an error is never a pass or a fail.
Result: <worktree>/output/structure/<screen>-<state>.json and the scored snapshot <screen>-<state>.ax.json,
overwritten by the next run of the same screen and state. --record ISSUE POINT (POINT: baseline | final) also
appends a row to .pm/issue-<ISSUE>/structure-scores.json of the checkout that holds this script. --table ISSUE
prints those rows as a markdown table and one line per point and screen saying whether every state it requires
passed.
"""
import argparse
import contextlib
import fcntl
import json
import os
import re
import signal
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _pmbrowse
import _pmproc
import _pmscore
import _pmspec
from _pmlib import PM, now

USAGE = ("pm-structure <worktree> <spec.yaml> (--url BASE | --serve DIR [--port N] | --snapshot FILE)\n"
         "                    [--state seeded|empty] [--storage-state FILE] [--record ISSUE POINT]\n"
         "       pm-structure --table ISSUE")
POINTS = ("baseline", "final")
GIT_TIMEOUT = 10
FIRST_FREE = 8090


class Failure(Exception):
    """An error the run reports on one stderr line and exits 2 with."""


class Terminated(BaseException):
    """The stop a signal records (`terminated by <SIGNAME>`); delivered by _pmproc at a checkpoint (issue 12, D3).
    A BaseException, so no `except Exception` takes it for an internal error."""


def say_error(message):
    sys.stderr.write(f"pm-structure: {message}\n")


def port_number(s):
    if not re.fullmatch(r"[1-9][0-9]{0,4}", s) or int(s) > 65535:
        raise argparse.ArgumentTypeError(f"not a port: {s!r}")
    return int(s)


def positive(s):
    return s if re.fullmatch(r"[1-9][0-9]*", s) else None


def git_state(wt):
    """(commit, dirty) of the worktree, or (None, None) when git cannot tell (design 2.6a)."""
    try:
        head = _pmproc.run(["git", "-C", wt, "rev-parse", "HEAD"], timeout=GIT_TIMEOUT, cwd=wt)
        status = _pmproc.run(["git", "-C", wt, "status", "--porcelain"], timeout=GIT_TIMEOUT, cwd=wt)
    except (OSError, subprocess.SubprocessError):
        return None, None
    commit = head.stdout.strip()
    if head.returncode != 0 or status.returncode != 0 or not re.fullmatch(r"[0-9a-f]{40,64}", commit):
        return None, None
    return commit, bool(status.stdout.strip())


def write_json(path, obj):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(_pmscore.dumps(obj))
    os.replace(tmp, path)


def issue_folder(issue):
    d = PM / f"issue-{issue}"
    if not d.is_dir():
        raise Failure(f"no issue folder .pm/issue-{issue}")
    return d


def read_rows(path):
    if not path.exists():
        return []
    try:
        rows = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeDecodeError, ValueError) as e:
        raise Failure(f"cannot read {path}: {e}") from None
    if not isinstance(rows, list) or not all(isinstance(r, dict) for r in rows):
        raise Failure(f"cannot read {path}: not a list of rows")
    return rows


def append_row(issue, row):
    """Append one row; the seeded and empty runs of a screen may record at once, so the read and replace hold an
    exclusive lock on structure-scores.json.lock (released when the file is closed, also on a crash)."""
    folder = issue_folder(issue)
    path = folder / "structure-scores.json"
    with open(folder / "structure-scores.json.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        rows = read_rows(path)
        rows.append(row)
        write_json(path, rows)


def serve_port(a, wt):
    """(port, how many ports to try): --port, else the studio port of <wt>/output/ports.json, else the first free
    port from 8090."""
    if a.port is not None:
        return a.port, 1
    ports = os.path.join(wt, "output", "ports.json")
    if os.path.exists(ports):
        try:
            with open(ports, encoding="utf-8") as f:
                port = json.load(f)["studio"]
            if isinstance(port, bool) or not isinstance(port, int) or not 0 < port < 65536:
                raise ValueError("studio is not a port")
        except (OSError, UnicodeDecodeError, ValueError, KeyError, TypeError) as e:
            raise _pmbrowse.BrowseError(f"cannot read {ports}: {e}") from None
        return port, 1
    return FIRST_FREE, 100


def take_snapshot(a, wt, spec, out_dir):
    """Run the browser and return the path of the settled snapshot (requirement 4)."""
    ax = os.path.join(out_dir, f"{spec.screen}-{a.state}.ax.json")
    with contextlib.suppress(FileNotFoundError):  # an error run leaves no snapshot of an earlier run behind
        os.unlink(ax)
    _pmbrowse.check_toolchain(wt)
    if a.storage_state is not None:
        _pmbrowse.check_storage_state(a.storage_state)
    job = os.path.join(out_dir, f"{spec.screen}-{a.state}-{os.getpid()}.job.json")
    logs = os.path.join(wt, "output", "logs")
    capture_log = os.path.join(logs, f"structure-capture-{spec.screen}-{a.state}.log")
    if a.url is not None:
        _pmbrowse.capture(wt, _pmbrowse.page_url(a.url, spec.route), ax, job, a.storage_state, capture_log)
        return ax
    port, tries = serve_port(a, wt)
    with _pmbrowse.serve(a.serve, port, log=os.path.join(logs, "structure-server.log"), tries=tries) as server:
        base = f"http://127.0.0.1:{server.server_address[1]}"
        _pmbrowse.capture(wt, _pmbrowse.page_url(base, spec.route), ax, job, a.storage_state, capture_log)
    return ax


def score_run(a, wt):
    """One scored run; returns the exit status."""
    out_dir = os.path.join(wt, "output", "structure")
    spec = None
    url = None
    try:
        spec = _pmspec.load(a.spec)
        if a.url is not None:
            _pmbrowse.check_url(a.url)
            url = _pmbrowse.page_url(a.url, spec.route)
    except (_pmspec.SpecError, _pmbrowse.BrowseError) as e:
        return error_result(a, wt, spec, e, url)
    _pmproc.check()  # C0: a stop before the lock exits 2 with nothing written
    try:
        held = _pmbrowse.lock(out_dir, spec.screen, a.state)
        held.__enter__()
    except _pmbrowse.Busy as e:  # the other run owns the result file; nothing is written
        say_error(str(e))
        return 2
    try:
        # from the lock to the report a stop is reported as the run's error (requirement R2.1); the reports
        # themselves stay outside this clause
        browse_error = score_error = None
        try:
            snapshot = a.snapshot
            if snapshot is None:
                try:
                    snapshot = take_snapshot(a, wt, spec, out_dir)
                except _pmbrowse.BrowseError as e:
                    browse_error = e
            _pmproc.check()  # C1: checks, server start, capture cleanup
            if browse_error is None:
                try:
                    snap = _pmscore.load_snapshot(snapshot)
                    result = _pmscore.score(spec, snap, a.state)
                except (_pmspec.SpecError, _pmscore.SnapshotError) as e:
                    score_error = e
                _pmproc.check()  # C2: scoring, before the report
        except Terminated as e:
            return error_result(a, wt, spec, e, url)
        if browse_error is not None:
            return error_result(a, wt, spec, browse_error, url)
        if score_error is not None:
            return error_result(a, wt, spec, score_error, url, snapshot)
        return scored_result(a, wt, spec, result, snapshot)
    finally:
        held.__exit__(None, None, None)


def error_result(a, wt, spec, e, url=None, snapshot=None):
    """Report an error: one stderr line; once the screen is known also the error result file and, with --record,
    an error row (design 2.6)."""
    screen = spec.screen if spec is not None else getattr(e, "screen", None)
    if screen is None:  # nothing to file the error under: no result file, no row
        say_error(str(e))
        return 2
    out_dir = os.path.join(wt, "output", "structure")
    commit, dirty = git_state(wt)
    path = os.path.join(out_dir, f"{screen}-{a.state}.json")
    requires = list(spec.needs_states) if spec is not None else [a.state]
    at = now()
    os.makedirs(out_dir, exist_ok=True)
    write_json(path, {"screen": screen, "state": a.state, "verdict": "error", "error": str(e),
                      "spec": os.path.abspath(a.spec), "spec_sha256": spec.sha256 if spec else None,
                      "snapshot": os.path.abspath(snapshot) if snapshot else None, "url": url,
                      "requires": requires, "commit": commit, "dirty": dirty, "at": at})
    sys.stdout.write(f"result: {path}\n")
    say_error(str(e))
    if a.record:
        try:
            append_row(a.record[0], {"point": a.record[1], "screen": screen, "state": a.state, "score": None,
                                     "matched": None, "total": None, "verdict": "error", "critical_unmatched": [],
                                     "requires": requires, "commit": commit, "dirty": dirty,
                                     "spec_sha256": spec.sha256 if spec else None, "result": path, "at": at})
        except Failure:
            pass  # the run's own error is the one line on stderr
    return 2


def scored_result(a, wt, spec, result, snapshot):
    out_dir = os.path.join(wt, "output", "structure")
    commit, dirty = git_state(wt)
    at = now()
    path = os.path.join(out_dir, f"{spec.screen}-{a.state}.json")
    os.makedirs(out_dir, exist_ok=True)
    write_json(path, _pmscore.result_json(result, {"commit": commit, "dirty": dirty, "at": at,
                                                   "snapshot": os.path.abspath(snapshot)}))
    if a.record:
        try:
            append_row(a.record[0], {"point": a.record[1], "screen": spec.screen, "state": a.state,
                                     "score": result.score, "matched": result.matched, "total": result.total,
                                     "verdict": result.verdict, "critical_unmatched": result.critical_unmatched,
                                     "requires": result.requires, "commit": commit, "dirty": dirty,
                                     "spec_sha256": spec.sha256, "result": path, "at": at})
        except Failure as e:
            sys.stdout.write(f"result: {path}\n")
            say_error(str(e))
            return 2
    sys.stdout.write(_pmscore.render_text(result, path))
    return 0 if result.verdict == "pass" else 1


def table_run(argv):
    p = argparse.ArgumentParser(prog="pm-structure", usage=USAGE)
    p.add_argument("--table", required=True, metavar="ISSUE")
    a = p.parse_args(argv)
    if positive(a.table) is None:
        p.error(f"ISSUE must be a positive integer, not {a.table!r}")
    rows = read_rows(issue_folder(a.table) / "structure-scores.json")
    sys.stdout.write(_pmscore.table(rows))
    return 0


def main(argv):
    if argv[:1] == ["--table"]:
        return table_run(argv)
    p = argparse.ArgumentParser(prog="pm-structure", usage=USAGE, description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("worktree")
    p.add_argument("spec")
    source = p.add_mutually_exclusive_group(required=True)
    source.add_argument("--url", metavar="BASE")
    source.add_argument("--serve", metavar="DIR")
    source.add_argument("--snapshot", metavar="FILE")
    p.add_argument("--port", type=port_number, metavar="N")
    p.add_argument("--storage-state", metavar="FILE")
    p.add_argument("--state", choices=_pmspec.STATES, default="seeded")
    p.add_argument("--record", nargs=2, metavar=("ISSUE", "POINT"))
    a = p.parse_args(argv)
    if a.record:
        if positive(a.record[0]) is None:
            p.error(f"--record ISSUE must be a positive integer, not {a.record[0]!r}")
        if a.record[1] not in POINTS:
            p.error(f"--record POINT must be one of {', '.join(POINTS)}, not {a.record[1]!r}")
    if a.port is not None and a.serve is None:
        p.error("--port needs --serve")
    if a.storage_state is not None and a.snapshot is not None:
        p.error("--storage-state needs --url or --serve")
    wt = os.path.abspath(a.worktree)
    if not os.path.isdir(wt):
        p.error(f"worktree {a.worktree} is not a directory")
    return score_run(a, wt)


if __name__ == "__main__":
    # the handler only records the first signal and never raises, so no cleanup is cut short; the stop is raised
    # at the next checkpoint or by the child wait in _pmproc.run (issue 12, design D1)
    for sig in (signal.SIGTERM, signal.SIGHUP, signal.SIGINT):
        signal.signal(sig, lambda signum, _: _pmproc.stop(Terminated(f"terminated by {signal.Signals(signum).name}")))
    try:
        code = main(sys.argv[1:])
    except Terminated:  # a stop outside the lock-held block: before the lock, or during a report
        code = 2
    except Failure as e:
        say_error(str(e))
        code = 2
    except Exception as e:  # never exit 0 or 1 on a bug
        say_error(f"internal error: {type(e).__name__}: {e}")
        code = 2
    if _pmproc.stop_requested() is not None:  # a signal where no checkpoint followed still ends in exit 2
        code = 2
    sys.exit(code)
