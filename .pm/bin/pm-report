#!/usr/bin/env -S python3 -I
"""Report a pane's line to the PM through a file instead of the terminal screen.

  pm-report "<STAGE READY|UNIT READY|ISSUE READY|BLOCKED|DONE|WAITING|RESET READY> <pane-name> …"
  pm-report --from <pane-name> "REVIEWED <stage> r<k> …"

Appends {ts, seq, pane, line} to .pm/run/reports.jsonl; pm-watchd is signalled, reads the file and delivers the
reporting lines (STAGE READY, UNIT READY, ISSUE READY, BLOCKED, DONE) verbatim to whoever hears the pane: the plan
of its issue for a worker, rev or crit pane of a plan-led issue, else the PM (_pmroute.py); WAITING, RESET READY and
REVIEWED are logged only. Every turn of a pane ends with one of these lines (pane-mode.md, Reporting lines); a turn
that ends with none is `EVENT silent <pane>` to its lead. Screen scraping stays as a fallback, but the file is
exact: no wrapped URLs, no Claude/Codex rendering differences, no duplicates. The pane name must be a registered,
live pane (pm-pane list), so a stray call cannot wake the PM. Print the same line in your reply as well.
"""
import argparse
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _pmlib import PANES, RUN, load, locked, now, save, wake_watchd

REPORTS = RUN / "reports.jsonl"
PREFIXES = ("STAGE READY", "UNIT READY", "ISSUE READY", "BLOCKED", "DONE", "WAITING", "RESET READY", "REVIEWED")


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("line", nargs="+")
    p.add_argument("--from", dest="sender", help="pane name, for REVIEWED lines (other lines carry the name themselves)")
    a = p.parse_args()
    line = " ".join(a.line).strip()
    line = re.sub(r"^[^A-Za-z]+", "", line)  # a pasted bullet or backtick
    prefix = next((x for x in PREFIXES if line.startswith(x)), None)
    if not prefix:
        sys.exit(f"not a reporting line (must start with one of {', '.join(PREFIXES)}): {line[:80]}")
    rest = line[len(prefix):].split()
    pane = a.sender if prefix == "REVIEWED" else (rest[0] if rest else None)
    live = {r["name"] for r in load(PANES, []) if not r.get("gone")}
    if not pane or pane not in live:
        sys.exit(f"pane {pane!r} is not a live registered pane ({', '.join(sorted(live)) or 'none'}); the line must name your pane")
    with locked(RUN / "reports.seq"):  # the number and the line under one lock: no two lines get one number (issue 504)
        seq = int(load(RUN / "reports.seq", 0) or 0) + 1
        save(RUN / "reports.seq", seq)
        with REPORTS.open("a") as f:
            f.write(json.dumps(dict(ts=now(), seq=seq, pane=pane, line=line), ensure_ascii=False) + "\n")
    wake_watchd()
    print(f"reported #{seq}: {line[:100]}")


main()
